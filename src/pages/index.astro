---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Hero from '~/components/sections/Hero.astro';
import Services from '~/components/sections/Services.astro';
import Projects from '~/components/sections/Projects.astro';
import PaintTool from '~/components/sections/PaintTool.astro';
import Process from '~/components/sections/Process.astro';
import Testimonials from '~/components/sections/Testimonials.astro';
import PaintStrip from '~/components/PaintStrip.astro';
---

<BaseLayout>
  <Hero />

  <!-- Pincelada que corta el hero y entra en el fondo claro. -->
  <svg class="brush-divider" viewBox="0 0 1200 34" preserveAspectRatio="none" aria-hidden="true">
    <path d="M0,10 C150,30 350,0 600,14 C850,28 1050,2 1200,16 L1200,34 L0,34 Z"></path>
  </svg>

  <Services />

  <!-- La franja va donde el fondo ya cambia (claro -> oscuro): así no abre
       ninguna costura entre dos secciones del mismo color. -->
  <div class="wrap strip-slot"><PaintStrip gap={30} /></div>

  <Projects />
  <PaintTool />
  <Process />
  <Testimonials />
</BaseLayout>

<script>
  import { initRevealOnScroll } from '~/scripts/reveal-on-scroll';

  initRevealOnScroll();
</script>
