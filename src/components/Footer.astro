---
import Logo from '~/components/Logo.astro';
import { SITE, CONTACT, SOCIAL } from '~/data/site';

const year = new Date().getFullYear();

/** Enlace real sólo cuando el dato lo es; si no, texto plano marcado. */
const phoneIsReal = !CONTACT.phoneHref.pending;
const emailIsReal = !CONTACT.email.pending;
---

<footer>
  <div class="wrap">
    <div class="footer-top">
      <div>
        <div class="footer-logo">
          <Logo width={116} />
          <span class="sr-only">PINTURESGS</span>
        </div>
        <p class="footer-tag">{SITE.tagline}</p>
      </div>

      <div class="footer-col">
        <h2>Contacto</h2>
        {phoneIsReal
          ? <a href={`tel:${CONTACT.phoneHref.value}`}>{CONTACT.phone.value}</a>
          : <p class="pending">{CONTACT.phone.value}</p>}
        {emailIsReal
          ? <a href={`mailto:${CONTACT.email.value}`}>{CONTACT.email.value}</a>
          : <p class="pending">{CONTACT.email.value}</p>}
        <a href="/presupuesto">Pedir presupuesto</a>
      </div>

      <div class="footer-col">
        <h2>Síguenos</h2>
        {SOCIAL.map((red) => (
          <a
            class="social-link"
            href={red.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${red.name} de ${SITE.name} (se abre en una pestaña nueva)`}
          >
            {red.name === 'Instagram' && (
              <svg class="social-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <rect x="2.5" y="2.5" width="19" height="19" rx="5.5" stroke="currentColor" stroke-width="1.7" />
                <circle cx="12" cy="12" r="4.2" stroke="currentColor" stroke-width="1.7" />
                <circle cx="17.6" cy="6.4" r="1.3" fill="currentColor" />
              </svg>
            )}
            {red.handle}
          </a>
        ))}
      </div>

      <div class="footer-col">
        <h2>Empresa</h2>
        <a href="/#servicios">Servicios</a>
        <a href="/#proyectos">Proyectos</a>
        <a href="/#proceso">Proceso</a>
        <p class:list={[{ pending: CONTACT.location.pending }]}>{CONTACT.location.value}</p>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {SITE.name}. Todos los derechos reservados.</span>
      <span class="footer-bottom-links">
        {SOCIAL.map((red) => (
          <a href={red.url} target="_blank" rel="noopener noreferrer">{red.name}</a>
        ))}
        {!CONTACT.email.pending && <a href={`mailto:${CONTACT.email.value}`}>{CONTACT.email.value}</a>}
      </span>
    </div>
  </div>
</footer>

<style>
  /* El pie se cierra con una pasada de brocha de toda la paleta en vez de
     con una línea gris. */
  footer {
    position: relative;
    padding: 76px 0 28px;
    background: var(--gesso);
    border-top: 1px solid var(--stone-light);
  }
  footer::before {
    content: '';
    position: absolute;
    top: -1px; left: 0; right: 0;
    height: 4px;
    background: var(--rainbow-line);
  }
  /* Cuatro columnas: marca, Contacto, Empresa y Síguenos. */
  .footer-top {
    display: grid;
    grid-template-columns: 1.3fr 1fr 1fr 1fr;
    gap: 46px;
    padding-bottom: 56px;
  }
  /* A tamaño medio no caben cuatro sin estrujarlas: la marca ocupa la fila. */
  @media (max-width: 1040px) {
    .footer-top { grid-template-columns: repeat(3, 1fr); gap: 34px 30px; }
    .footer-top > :first-child { grid-column: 1 / -1; }
  }
  @media (max-width: 760px) {
    .footer-top { grid-template-columns: 1fr; gap: 34px; }
    .footer-top > :first-child { grid-column: auto; }
  }

  .footer-logo { margin-bottom: 14px; }
  .footer-logo :global(img) { height: 58px; width: auto; }

  .footer-tag {
    font-size: 0.92rem;
    color: var(--stone);
    max-width: 300px;
    line-height: 1.5;
  }

  .footer-col h2 {
    font-family: var(--sans);
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--stone);
    margin-bottom: 14px;
  }
  .footer-col a, .footer-col p {
    display: block;
    font-size: 0.88rem;
    margin-bottom: 9px;
  }
  .footer-col a:hover { color: var(--terracotta); }

  /* Dato pendiente: se ve que lo es, sin parecer un enlace roto. */
  .pending { color: var(--stone); font-style: italic; }

  /* El icono acompaña al arroba; se tiñe con el color del enlace. */
  .social-link { display: inline-flex; align-items: center; gap: 8px; }
  .social-icon { flex: none; }

  .footer-bottom-links { display: flex; gap: 18px; flex-wrap: wrap; }

  .footer-bottom {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 24px;
    border-top: 1px solid var(--stone-light);
    font-size: 0.74rem;
    color: var(--stone);
    flex-wrap: wrap;
    gap: 10px;
  }
</style>
