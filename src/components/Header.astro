---
/**
 * Menú fijo. Empieza transparente sobre el hero y se vuelve sólido al bajar.
 * El logotipo se encoge en ese mismo momento.
 */
import Logo from '~/components/Logo.astro';

interface Props {
  /**
   * La página empieza con un bloque oscuro (p. ej. /presupuesto). El menú es
   * transparente hasta que se baja, así que sin esto sus enlaces salen en
   * tinta oscura sobre fondo oscuro y no se ven.
   */
  onDark?: boolean;
}
const { onDark = false } = Astro.props;

/*
  Las secciones viven en la portada, así que los enlaces llevan la barra
  delante: desde /presupuesto una ancla suelta no lleva a ninguna parte. Desde
  la propia home el navegador sigue tratándolo como un salto interno.
*/
const links = [
  { href: '/#servicios', label: 'Servicios' },
  { href: '/#proyectos', label: 'Proyectos' },
  { href: '/#pinta', label: 'Pinta tu espacio' },
  { href: '/#proceso', label: 'Proceso' },
  { href: '/#testimonios', label: 'Testimonios' },
  { href: '/#nosotros', label: 'Nosotros' },
];
---

<header id="siteHeader" class:list={[{ 'on-dark-top': onDark }]}>
  <div class="wrap">
    <nav aria-label="Navegación principal">
      <a href="/" class="logo">
        <Logo width={116} eager />
        <span class="sr-only">PINTURESGS — ir al inicio</span>
      </a>

      <div class="nav-links" id="navLinks">
        {links.map((l) => <a href={l.href} data-nav>{l.label}</a>)}
        <a href="/presupuesto" class="nav-cta" data-nav>Pedir presupuesto</a>
      </div>

      <button
        class="nav-toggle"
        id="navToggle"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="navLinks"
      >
        <svg width="22" height="16" viewBox="0 0 22 16" aria-hidden="true">
          <rect width="22" height="1.6" fill="currentColor" />
          <rect y="7" width="22" height="1.6" fill="currentColor" />
          <rect y="14" width="22" height="1.6" fill="currentColor" />
        </svg>
      </button>
    </nav>
  </div>

  <!--
    Filete de progreso: se pinta de izquierda a derecha según se baja por la
    página. Va con `animation-timeline: scroll()`, sin JavaScript ni listeners
    de scroll; en los navegadores que aún no lo soportan sencillamente no se
    muestra y el menú se queda como estaba.
  -->
  <span class="head-progress" aria-hidden="true"></span>
</header>

<style>
  header {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    padding: 24px 0;
    transition: background .4s ease, padding .4s ease, border-color .4s ease;
    border-bottom: 1px solid transparent;
  }
  header.solid {
    background: rgba(250, 250, 248, 0.94);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    padding: 14px 0;
    border-bottom: 1px solid var(--stone-light);
  }

  nav { display: flex; align-items: center; justify-content: space-between; }

  .head-progress { display: none; }
  @supports (animation-timeline: scroll()) {
    .head-progress {
      display: block;
      position: absolute;
      left: 0; right: 0; bottom: -1px;
      height: 3px;
      background: var(--rainbow-line);
      transform: scaleX(0);
      transform-origin: left;
      opacity: 0;
      transition: opacity .4s ease;
      animation: headProgress linear both;
      animation-timeline: scroll(root block);
    }
    header.solid .head-progress { opacity: 1; }
    @keyframes headProgress {
      from { transform: scaleX(0); }
      to   { transform: scaleX(1); }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .head-progress { display: none; }
  }

  .logo { display: flex; align-items: center; }
  .logo :global(img) {
    height: 58px;
    width: auto;
    transition: height .4s ease;
  }
  header.solid .logo :global(img) { height: 46px; }

  .nav-links { display: flex; gap: 36px; align-items: center; }
  .nav-links a { font-size: 0.86rem; position: relative; }
  /* El subrayado del menú es una pincelada con la paleta entera. */
  .nav-links a:not(.nav-cta)::after {
    content: '';
    position: absolute;
    left: 0; bottom: -5px;
    width: 100%; height: 3px;
    border-radius: 3px;
    background: var(--rainbow-line);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .32s var(--ease-out-soft);
  }
  .nav-links a:not(.nav-cta):hover::after,
  .nav-links a:not(.nav-cta):focus-visible::after { transform: scaleX(1); }

  .nav-cta {
    border: 1px solid var(--ink);
    padding: 9px 18px;
    border-radius: 2px;
    font-size: 0.8rem;
    transition: background .3s ease, color .3s ease, border-color .3s ease;
  }
  .nav-cta:hover, .nav-cta:focus-visible {
    background: var(--rainbow-line);
    background-size: 180% 100%;
    border-color: transparent;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.35);
  }

  .nav-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 6px;
  }

  /*
    Sobre fondo oscuro y sin haber bajado todavía, todo el menú va en claro.
    En cuanto aparece el fondo sólido (`.solid`) se vuelve a la tinta normal, y
    el desplegable de móvil mantiene su fondo claro y sus enlaces oscuros.
  */
  header.on-dark-top:not(.solid) .nav-links:not(.open) a { color: var(--gesso); }
  header.on-dark-top:not(.solid) .nav-toggle { color: var(--gesso); }
  header.on-dark-top:not(.solid) .nav-links:not(.open) .nav-cta { border-color: var(--gesso); }

  @media (max-width: 900px) {
    .nav-links {
      position: fixed;
      inset: 0;
      background: var(--gesso);
      flex-direction: column;
      justify-content: center;
      gap: 32px;
      transform: translateY(-100%);
      transition: transform .4s ease;
      /* Sin esto los enlaces siguen siendo tabulables con el menú cerrado. */
      visibility: hidden;
    }
    .nav-links.open { transform: translateY(0); visibility: visible; }
    .nav-links a { font-size: 1.35rem; }
    .nav-toggle { display: block; z-index: 101; }
  }
</style>

<script>
  import { initNav } from '~/scripts/nav';
  initNav();
</script>
