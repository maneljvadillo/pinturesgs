  { x: 95.2, y: 80.3, s: 1.4, c: 'purple', t: 170, rot: 2, run: 0, rd: 0, rs: 0, stay: false },
  { x: 17.4, y: 32.2, s: 1.2, c: 'turq', t: 171, rot: 6, run: 7.5, rd: 1728, rs: 419, stay: false },  // en móvil el titular se centra y esta caía justo encima: no deja residuo
  { x: 70, y: 102.3, s: 2.04, c: 'yellow', t: 178, rot: 21, run: 12.4, rd: 2224, rs: 352, stay: false },
  { x: 8.1, y: 57, s: 1.2, c: 'yellow', t: 184, rot: -28, run: 0, rd: 0, rs: 0, stay: false },
  { x: 39.3, y: 88, s: 1.36, c: 'pink', t: 189, rot: -26, run: 0, rd: 0, rs: 0, stay: true },
  { x: 96.1, y: 96.4, s: 2.33, c: 'purple', t: 190, rot: 4, run: 0, rd: 0, rs: 0, stay: false },
