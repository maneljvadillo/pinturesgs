---

<div
  class="paint-splatter"
  aria-hidden="true"
  style={`--cx: ${IMPACT.x}%; --cy: ${IMPACT.y}%;`}
>
  {SPLASHES.map((s) => (
    <span
      class="ps-splash"
      style={`--x: ${s.x}%; --y: ${s.y}%; --s: ${s.s}vmin; --t: ${s.t}ms; --rot: ${s.rot}deg; --o: ${s.o}; --r: ${s.r};`}
    ></span>
  ))}

  <span class="ps-bloom"></span>

  {DROPS.map((d) => (
    <i
      class:list={['ps-drop', { stay: d.stay }]}
      style={`--x: ${d.x}%; --y: ${d.y}%; --s: ${d.s}vmin; --c: var(--c-${d.c}); --t: ${d.t}ms; --rot: ${d.rot}deg; --run: ${d.run}vh; --rd: ${d.rd}ms; --rs: ${d.rs}ms;`}
    >
      {d.run > 0 && (
        <>
          <span class="ps-run"></span>
          <span class="ps-bulb"></span>
        </>
      )}
    </i>
  ))}
</div>

<style>
  .paint-splatter {
    position: absolute;
    inset: 0;
    /* Por delante del contenido (z-index 2) y por detrás del menú (100) y de
       la brocha (200): la pintura está en el cristal, no en la página. */
    z-index: 5;
    pointer-events: none;
    overflow: hidden;
    /*
      SIN `filter` aquí. Un filtro en el contenedor obliga a componer la capa
      entera —con sus 86 hijos animándose— en cada fotograma, que es
      exactamente lo contrario de lo que se quiere. La paleta de marca ya está
      saturada de origen; no hacía falta.
    */
  }

  /* ── Los pegotes grandes ──────────────────────────────────────────── */
  .ps-splash {
    position: absolute;
    left: var(--x); top: var(--y);
    width: var(--s);
    aspect-ratio: 1;
    margin: calc(var(--s) * -.5) 0 0 calc(var(--s) * -.5);
    background: var(--rainbow);
    border-radius: var(--r);
    filter: blur(10px) saturate(1.4);
    opacity: 0;
    will-change: transform, opacity;
    /* 1,6 s para disolverse: es lo que hace que se vaya en vez de cortarse. */
    animation: psSplash 1.6s linear calc(var(--hero-impact) + var(--t)) both;
  }
  @keyframes psSplash {
    0%   { opacity: 0;       transform: rotate(var(--rot)) scale(.14);
           animation-timing-function: cubic-bezier(.16, .9, .3, 1); }
    13%  { opacity: var(--o); transform: rotate(var(--rot)) scale3d(1.16, .93, 1);
           animation-timing-function: cubic-bezier(.4, 0, .3, 1); }
    28%  { opacity: var(--o); transform: rotate(var(--rot)) scale(1.01);
           animation-timing-function: cubic-bezier(.5, 0, .8, .6); }
    100% { opacity: 0;       transform: rotate(var(--rot)) scale(1.12); }
  }

  /* Destello del golpe: lo que "ciega" un instante al recibir el cubo. */
  .ps-bloom {
    position: absolute;
    left: var(--cx); top: var(--cy);
    width: 55vmax;
    aspect-ratio: 1;
    margin: -27.5vmax 0 0 -27.5vmax;
    background: radial-gradient(circle, rgba(255,255,255,.5) 0%, rgba(255,255,255,.16) 24%, transparent 56%);
    opacity: 0;
    will-change: transform, opacity;
    animation: psBloom 640ms linear var(--hero-impact) both;
  }
  @keyframes psBloom {
    0%   { opacity: 0;   transform: scale(.06);
           animation-timing-function: cubic-bezier(.1, .9, .3, 1); }
    18%  { opacity: .7;  transform: scale(.42);
           animation-timing-function: cubic-bezier(.4, 0, .7, .8); }
    100% { opacity: 0;   transform: scale(1); }
  }

  /* ── Las gotas ────────────────────────────────────────────────────── */
  .ps-drop {
    position: absolute;
    left: var(--x); top: var(--y);
    width: var(--s);
    height: calc(var(--s) * .9);
    margin: calc(var(--s) * -.45) 0 0 calc(var(--s) * -.5);
    background: var(--c);
    /* Radios desiguales en los dos ejes: una gota estampada no es un círculo. */
    border-radius: 58% 42% 47% 53% / 52% 56% 44% 48%;
    box-shadow:
      inset 0 calc(var(--s) * -.13) calc(var(--s) * .24) rgba(0, 0, 0, .34),
      0 calc(var(--s) * .07) calc(var(--s) * .16) rgba(0, 0, 0, .2);
    opacity: 0;
    /*
      Sin `will-change`: son 42 gotas, 22 regueros y 22 bolas. Declararlo
      creaba 86 capas de compositor desde que carga la página, todas con su
      textura, esperando a animarse. El navegador ya promociona solo lo que
      tiene una animación de `transform`/`opacity` en marcha, y la retira al
      acabar; declararlo aquí sólo servía para tenerlas todas a la vez.
    */
    /*
      Una sola animación para las tres fases (estamparse, aguantar, apagarse).
      Con dos animaciones encadenadas sobre `opacity` la fase de espera pelea
      con el relleno de la primera y la gota parpadea al empezar la segunda.
    */
    animation: psDrop 4.4s linear calc(var(--hero-impact) + var(--t)) both;
  }
  /* Brillo húmedo. Sin esto la gota es un círculo plano de color. */
  .ps-drop::before {
    content: '';
    position: absolute;
    left: 20%; top: 13%;
    width: 34%; height: 27%;
    border-radius: 50%;
    background: rgba(255, 255, 255, .62);
  }

  /* Se estampa: llega aplastada contra el cristal, rebota estirándose y se
     asienta. Tres tramos, tres curvas. */
  @keyframes psDrop {
    0%   { opacity: 0; transform: rotate(var(--rot)) scale(.08);
           animation-timing-function: cubic-bezier(.14, .9, .32, 1); }
    5%   { opacity: 1; transform: rotate(var(--rot)) scale3d(1.34, .8, 1);
           animation-timing-function: cubic-bezier(.36, 0, .28, 1); }
    11%  { transform: rotate(var(--rot)) scale3d(.93, 1.09, 1);
           animation-timing-function: cubic-bezier(.4, 0, .3, 1); }
    18%  { transform: rotate(var(--rot)) scale(1);
           animation-timing-function: linear; }
    62%  { opacity: 1; transform: rotate(var(--rot)) scale(1); }
    100% { opacity: 0; transform: rotate(var(--rot)) scale(1); }
  }
  /* Las de los bordes NO se van del todo: quedan como residuo tenue. Si
     desaparece todo parece un GIF; si se queda todo, tapa el titular. */
  .ps-drop.stay { animation-name: psDropStay; }
  @keyframes psDropStay {
    0%   { opacity: 0; transform: rotate(var(--rot)) scale(.08);
           animation-timing-function: cubic-bezier(.14, .9, .32, 1); }
    5%   { opacity: 1; transform: rotate(var(--rot)) scale3d(1.34, .8, 1);
           animation-timing-function: cubic-bezier(.36, 0, .28, 1); }
    11%  { transform: rotate(var(--rot)) scale3d(.93, 1.09, 1);
           animation-timing-function: cubic-bezier(.4, 0, .3, 1); }
    18%  { transform: rotate(var(--rot)) scale(1);
           animation-timing-function: linear; }
    62%  { opacity: 1; transform: rotate(var(--rot)) scale(1); }
    100% { opacity: .16; transform: rotate(var(--rot)) scale(1); }
  }

  /* ── El chorretón ─────────────────────────────────────────────────── */
  .ps-run, .ps-bulb {
    position: absolute;
    background: var(--c);
    /*
      Arranca rápido y frena mucho: la pintura sale disparada por el golpe y
      se queda sin impulso contra el cristal. Una curva lineal aquí parece un
      cursor de carga bajando.

      `--rs` es propio de cada gota: unas empiezan a chorrear casi al momento
      y otras medio segundo después, cuando la de al lado ya va por la mitad.
    */
    animation-duration: var(--rd);
    animation-timing-function: cubic-bezier(.08, .58, .16, 1);
    animation-delay: calc(var(--hero-impact) + var(--t) + var(--rs));
    animation-fill-mode: both;
  }
  .ps-run {
    left: 50%; top: 38%;
    width: calc(var(--s) * .4);
    height: var(--run);
    margin-left: calc(var(--s) * -.2);
    border-radius: calc(var(--s) * .2) calc(var(--s) * .2) 0 0;
    transform-origin: top;
    animation-name: psRun;
  }
  @keyframes psRun {
    from { transform: scaleY(0); }
    to   { transform: scaleY(1); }
  }
  /* La bola de la punta va aparte y sólo BAJA: si fuese parte del reguero, el
     `scaleY` la estiraría hasta dejarla en un churro. */
  .ps-bulb {
    left: 50%; top: 38%;
    width: calc(var(--s) * .6);
    height: calc(var(--s) * .66);
    margin-left: calc(var(--s) * -.3);
    border-radius: 50% 50% 54% 46% / 42% 42% 58% 58%;
    box-shadow: inset 0 calc(var(--s) * -.1) calc(var(--s) * .2) rgba(0, 0, 0, .3);
    animation-name: psBulb;
  }
  @keyframes psBulb {
    from { transform: translateY(0) scale(.5); }
    to   { transform: translateY(var(--run)) scale(1); }
  }

  /* Nada de esto tiene sentido si se ha pedido menos movimiento. */
  @media (prefers-reduced-motion: reduce) {
    .paint-splatter { display: none; }
  }
</style>
