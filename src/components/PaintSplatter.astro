---

<div
  class="paint-splatter"
  aria-hidden="true"
  style={`--cx: ${IMPACT.x}%; --cy: ${IMPACT.y}%;`}
>
  <span class="ps-wash"></span>
  <span class="ps-bloom"></span>

  {DROPS.map((d) => (
    <i
      class:list={['ps-drop', { stay: d.stay }]}
      style={`--x: ${d.x}%; --y: ${d.y}%; --s: ${d.s}vmin; --c: var(--c-${d.c}); --t: ${d.t}ms; --run: ${d.run}vh; --rd: ${d.rd}ms;`}
    >
      {d.run > 0 && (
        <>
          <span class="ps-run"></span>
          <span class="ps-bulb"></span>
        </>
      )}
    </i>
  ))}
</div>

<style>
  .paint-splatter {
    position: absolute;
    inset: 0;
    /* Por delante del contenido (z-index 2) y por detrás del menú (100) y de
       la brocha (200): la pintura está en el cristal, no en la página. */
    z-index: 5;
    pointer-events: none;
    overflow: hidden;
    filter: saturate(1.3);
  }

  /* ── El pintarrajo del impacto ────────────────────────────────────── */
  .ps-wash {
    position: absolute;
    left: var(--cx); top: var(--cy);
    width: 86vmin;
    aspect-ratio: 1;
    margin: -43vmin 0 0 -43vmin;
    background: var(--rainbow);
    border-radius: 46% 54% 38% 62% / 55% 42% 58% 45%;
    filter: blur(18px) saturate(1.5);
    opacity: 0;
    will-change: transform, opacity;
    animation: psWash 1.1s var(--ease-out-soft) var(--hero-impact) both;
  }
  @keyframes psWash {
    0%   { opacity: 0;   transform: scale(.18) rotate(-6deg); }
    12%  { opacity: .72; transform: scale(1.1) rotate(2deg); }
    38%  { opacity: .34; transform: scale(1) rotate(0deg); }
    100% { opacity: 0;   transform: scale(1.06); }
  }

  /* Destello del golpe: lo que "ciega" un instante al recibir el cubo. */
  .ps-bloom {
    position: absolute;
    left: var(--cx); top: var(--cy);
    width: 80vmax;
    aspect-ratio: 1;
    margin: -40vmax 0 0 -40vmax;
    background: radial-gradient(circle, rgba(255,255,255,.6) 0%, rgba(255,255,255,.2) 24%, transparent 56%);
    opacity: 0;
    will-change: transform, opacity;
    animation: psBloom 520ms var(--ease-out-soft) var(--hero-impact) both;
  }
  @keyframes psBloom {
    0%   { opacity: 0;  transform: scale(.06); }
    16%  { opacity: .85; }
    100% { opacity: 0;  transform: scale(1); }
  }

  /* ── Las gotas ────────────────────────────────────────────────────── */
  .ps-drop {
    position: absolute;
    left: var(--x); top: var(--y);
    width: var(--s);
    height: calc(var(--s) * .9);
    margin: calc(var(--s) * -.45) 0 0 calc(var(--s) * -.5);
    background: var(--c);
    /* Radios desiguales en los dos ejes: una gota estampada no es un círculo. */
    border-radius: 58% 42% 47% 53% / 52% 56% 44% 48%;
    box-shadow:
      inset 0 calc(var(--s) * -.13) calc(var(--s) * .24) rgba(0, 0, 0, .34),
      0 calc(var(--s) * .07) calc(var(--s) * .16) rgba(0, 0, 0, .2);
    opacity: 0;
    will-change: transform, opacity;
    /*
      Una sola animación para las tres fases (reventar, aguantar, apagarse).
      Con dos animaciones encadenadas sobre `opacity` la fase de espera pelea
      con el relleno de la primera y la gota parpadea al empezar la segunda.
    */
    animation: psDrop 3.6s linear calc(var(--hero-impact) + var(--t)) both;
  }
  /* Brillo húmedo. Sin esto la gota es un círculo plano de color. */
  .ps-drop::before {
    content: '';
    position: absolute;
    left: 20%; top: 13%;
    width: 34%; height: 27%;
    border-radius: 50%;
    background: rgba(255, 255, 255, .62);
  }

  @keyframes psDrop {
    0%   { opacity: 0; transform: scale(.15); }
    4%   { opacity: 1; transform: scale(1.28); }
    8%   {             transform: scale(.94); }
    12%  {             transform: scale(1); }
    55%  { opacity: 1; }
    100% { opacity: 0; transform: scale(1); }
  }
  .ps-drop.stay { animation-name: psDropStay; }
  @keyframes psDropStay {
    0%   { opacity: 0;   transform: scale(.15); }
    4%   { opacity: 1;   transform: scale(1.28); }
    8%   {               transform: scale(.94); }
    12%  {               transform: scale(1); }
    55%  { opacity: 1; }
    100% { opacity: .17; transform: scale(1); }
  }

  /* ── El chorretón ─────────────────────────────────────────────────── */
  .ps-run, .ps-bulb {
    position: absolute;
    background: var(--c);
    /*
      Arranca rápido y frena mucho: la pintura sale disparada por el golpe y
      se queda sin impulso contra el cristal. Una curva lineal aquí parece un
      cursor de carga bajando.
    */
    animation-duration: var(--rd);
    animation-timing-function: cubic-bezier(.1, .62, .2, 1);
    animation-delay: calc(var(--hero-impact) + var(--t) + 130ms);
    animation-fill-mode: both;
  }
  .ps-run {
    left: 50%; top: 38%;
    width: calc(var(--s) * .4);
    height: var(--run);
    margin-left: calc(var(--s) * -.2);
    border-radius: calc(var(--s) * .2) calc(var(--s) * .2) 0 0;
    transform-origin: top;
    animation-name: psRun;
  }
  @keyframes psRun {
    from { transform: scaleY(0); }
    to   { transform: scaleY(1); }
  }
  /* La bola de la punta va aparte y sólo BAJA: si fuese parte del reguero, el
     `scaleY` la estiraría hasta dejarla en un churro. */
  .ps-bulb {
    left: 50%; top: 38%;
    width: calc(var(--s) * .6);
    height: calc(var(--s) * .66);
    margin-left: calc(var(--s) * -.3);
    border-radius: 50% 50% 54% 46% / 42% 42% 58% 58%;
    box-shadow: inset 0 calc(var(--s) * -.1) calc(var(--s) * .2) rgba(0, 0, 0, .3);
    animation-name: psBulb;
  }
  @keyframes psBulb {
    from { transform: translateY(0) scale(.5); }
    to   { transform: translateY(var(--run)) scale(1); }
  }

  /* Nada de esto tiene sentido si se ha pedido menos movimiento. */
  @media (prefers-reduced-motion: reduce) {
    .paint-splatter { display: none; }
  }
</style>
