  { x: 57.2, y: 22.1, s: 4.19, c: 'orange', t: 112, rot: -18, run: 0, rd: 0, rs: 0, stay: false },
  { x: 43.5, y: 21.5, s: 1.58, c: 'turq', t: 114, rot: -13, run: 5, rd: 1386, rs: 409, stay: false },
  { x: 58.9, y: 76, s: 2.44, c: 'red', t: 116, rot: -5, run: 17, rd: 2455, rs: 160, stay: false },
  { x: 36, y: 48.1, s: 1.2, c: 'green', t: 119, rot: 1, run: 4.2, rd: 1358, rs: 547, stay: false },
  { x: 40.7, y: 74.4, s: 1.67, c: 'yellow', t: 132, rot: 9, run: 0, rd: 0, rs: 0, stay: false },
  { x: 87.1, y: 59.2, s: 2.63, c: 'yellow', t: 139, rot: 36, run: 0, rd: 0, rs: 0, stay: false },
  { x: 62.1, y: 62.1, s: 4.34, c: 'orange', t: 143, rot: 42, run: 17.9, rd: 2603, rs: 247, stay: false },
  { x: 45.9, y: 64.5, s: 1.2, c: 'green', t: 146, rot: -14, run: 0, rd: 0, rs: 0, stay: false },
  { x: 81.7, y: 88, s: 2.91, c: 'green', t: 157, rot: 21, run: 23.2, rd: 2762, rs: 322, stay: true },
