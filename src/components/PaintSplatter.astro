  { x: 101.3, y: 95.9, s: 1.42, c: 'pink', t: 121, run: 0, rd: 0, stay: true },
  { x: 16.6, y: 15.2, s: 1.62, c: 'yellow', t: 123, run: 0, rd: 0, stay: false },
  { x: 72.6, y: 87.5, s: 2.25, c: 'pink', t: 123, run: 0, rd: 0, stay: false },
  { x: 89, y: 92.2, s: 1.69, c: 'yellow', t: 127, run: 2, rd: 1157, stay: false },
  { x: 16.4, y: 51.3, s: 1.15, c: 'orange', t: 128, run: 3.7, rd: 1238, stay: false },
  { x: 71.4, y: 100.7, s: 2.05, c: 'turq', t: 137, run: 23.1, rd: 2326, stay: false },
  { x: 5.7, y: 58.7, s: 1.15, c: 'green', t: 144, run: 0, rd: 0, stay: false },
  { x: 39.5, y: 87.3, s: 1.17, c: 'yellow', t: 146, run: 0, rd: 0, stay: true },
