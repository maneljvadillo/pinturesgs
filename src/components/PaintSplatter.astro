  { x: 32.1, y: 99, s: 1.74, c: 'red', t: 265, rot: 20, run: 0, rd: 0, rs: 0, stay: false },
  { x: 48, y: 29.5, s: 3.62, c: 'orange', t: 296, rot: 0, run: 5.3, rd: 1540, rs: 214, stay: false },
  { x: 83.8, y: 42.8, s: 1.96, c: 'green', t: 300, rot: 20, run: 0, rd: 0, rs: 0, stay: false },
  { x: 98.8, y: 13.6, s: 1.99, c: 'blue', t: 314, rot: -11, run: 4.9, rd: 1652, rs: 302, stay: false },
  { x: 65.2, y: 16.9, s: 1.69, c: 'pink', t: 329, rot: -31, run: 0, rd: 0, rs: 0, stay: false },
  { x: 58.7, y: 26.2, s: 3.73, c: 'yellow', t: 337, rot: -4, run: 13.6, rd: 2292, rs: 543, stay: false },
  { x: 49.6, y: 83.5, s: 2.78, c: 'red', t: 354, rot: 8, run: 0, rd: 0, rs: 0, stay: false },
  { x: 11.2, y: 39.9, s: 1.2, c: 'turq', t: 376, rot: -27, run: 0, rd: 0, rs: 0, stay: false },
  { x: 83.7, y: 95, s: 3.06, c: 'pink', t: 391, rot: 16, run: 22.5, rd: 3059, rs: 370, stay: false },
  { x: 25.2, y: 49.2, s: 1.2, c: 'red', t: 394, rot: -4, run: 0, rd: 0, rs: 0, stay: false },
  { x: 42.2, y: 10.3, s: 2.42, c: 'pink', t: 401, rot: -19, run: 0, rd: 0, rs: 0, stay: true },
