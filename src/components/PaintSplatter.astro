 * delante del cubo) y el tercero se retrasa.
 */
const SPLASHES = [
  { x: 71, y: 47, s: 88, t: 0,   rot: -6,  o: 0.7,  r: '46% 54% 38% 62% / 55% 42% 58% 45%' },
  { x: 50, y: 63, s: 56, t: -90, rot: 13,  o: 0.44, r: '58% 42% 62% 38% / 42% 63% 37% 58%' },
  { x: 86, y: 31, s: 48, t: 150, rot: -15, o: 0.4,  r: '39% 61% 44% 56% / 62% 37% 63% 38%' },
];

const DROPS = [
