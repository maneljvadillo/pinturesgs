---
/**
 * Todo el <head>: metadatos, Open Graph, fuentes y datos estructurados.
 *
 * El JSON-LD describe el negocio como HousePainter. Los campos que siguen
 * siendo placeholders (email, dirección postal) se OMITEN a propósito: es
 * preferible un dato ausente a un dato inventado, y Google penaliza los datos
 * estructurados que no se corresponden con lo que se ve en la página.
 */
import { SITE, CONTACT, SOCIAL } from '~/data/site';
import { SERVICES } from '~/data/services';

interface Props {
  title?: string;
  description?: string;
  /** Ruta de la imagen social, relativa a la raíz del sitio. */
  image?: string;
  noindex?: boolean;
}

const {
  title = SITE.seoTitle,
  description = SITE.description,
  image = '/og.png',
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL(image, Astro.site ?? SITE.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'HousePainter',
  name: SITE.legalName,
  alternateName: SITE.name,
  description: SITE.description,
  url: SITE.url,
  image: ogImage,
  slogan: SITE.tagline,
  // Sólo se publican los datos de contacto que ya son reales.
  ...(CONTACT.phoneHref.pending ? {} : { telephone: CONTACT.phoneHref.value }),
  ...(CONTACT.email.pending ? {} : { email: CONTACT.email.value }),
  /*
    `sameAs` es donde Google espera encontrar los perfiles oficiales de la
    empresa. Sirve para que relacione la web con el Instagram y no los trate
    como dos negocios distintos.
  */
  ...(SOCIAL.length > 0 ? { sameAs: SOCIAL.map((r) => r.url) } : {}),
  /*
    El ámbito va como `areaServed`, NO como `address`: lo único que consta es
    el territorio ("Principat d'Andorra"), y no hay dirección postal de la
    empresa en ninguna fuente. Publicar un país en `address` sería declarar
    una sede que no sabemos cuál es, y Google penaliza los datos estructurados
    que no se corresponden con la realidad.
  */
  ...(CONTACT.location.pending
    ? {}
    : { areaServed: { '@type': 'Country', name: 'Andorra' } }),
  makesOffer: SERVICES.map((s) => ({
    '@type': 'Offer',
    itemOffered: { '@type': 'Service', name: `Pintura — ${s.name}`, serviceType: s.tasks.join(', ') },
  })),
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<meta name="generator" content={Astro.generator} />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:locale" content={SITE.locale} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<meta name="theme-color" content="#FAFAF8" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

<!--
  Las fuentes se precargan con preconnect + display=swap. Sólo se piden los
  pesos que realmente se usan, para no arrastrar una familia variable entera.
-->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap"
/>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
