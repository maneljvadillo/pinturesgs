---
/**
 * PROYECTOS — rejilla oscura. Al pasar por encima, una pincelada diagonal
 * descubre el nombre del proyecto y los servicios aplicados.
 */
import { Image } from 'astro:assets';
import { PROJECTS } from '~/data/projects';
import { photoSrc, photoAlt } from '~/lib/photos';

const anySample = PROJECTS.some((p) => p.sample);

/** Un color de marca por proyecto, en rotación fija. */
const ACCENTS = ['yellow', 'turq', 'pink', 'green', 'orange', 'blue'];
---

<section class="projects on-dark" id="proyectos">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Proyectos</span>
      <h2>Nuestro trabajo habla por nosotros.</h2>
    </div>

    <ul class="project-grid">
      {PROJECTS.map((p, pi) => {
        const img = photoSrc(p.photo);
        const accent = ACCENTS[pi % ACCENTS.length];
        return (
          <li
            class="project-card grain"
            data-reveal="zoom"
            style={`--accent: var(--c-${accent}); --reveal-i: ${pi % 3};`}
          >
            {img ? (
              <Image
                class="pc-bg"
                src={img}
                alt={photoAlt(p.photo)}
                widths={[400, 700, 900]}
                sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 33vw"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="pc-bg" style={`background:${p.fallback};`} aria-hidden="true"></div>
            )}
            <span class="pc-tint" aria-hidden="true"></span>
            <div class="pc-overlay">
              <span class="pc-stroke" aria-hidden="true"></span>
              <h3 class="pc-title">{p.title}</h3>
              <p class="pc-tags">{p.tags.join(' · ')}</p>
            </div>
          </li>
        );
      })}
    </ul>

    {anySample && (
      <p class="photo-note">
        Ejemplos del tipo de proyecto que abordamos. Las fotografías son de referencia.
      </p>
    )}
  </div>
</section>

<style>
  .projects {
    --accent: var(--c-yellow);
    padding: 110px 0;
    background: var(--ink);
    color: var(--gesso);
  }
  .projects .section-head :global(.eyebrow) { color: #8f8b83; }
  .projects :global(h2) { color: var(--gesso); }
  .projects .photo-note { color: #8f8b83; }

  .project-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
    list-style: none;
  }
  @media (max-width: 900px) { .project-grid { grid-template-columns: repeat(2, 1fr); } }
  /* Seis obras a una columna eran tres pantallas y media de scroll. */
  @media (max-width: 560px) { .project-grid { gap: 2px; } }

  .project-card {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    background: #2a2925;
  }

  .pc-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.95;
    transition: transform .6s var(--ease-out-soft);
  }
  .project-card:hover .pc-bg { transform: scale(1.06); }

  /*
    Baño de color sobre la obra. Aquí el fondo es oscuro, así que se usa
    `screen` en vez de `multiply`: aclara y tiñe en lugar de ensuciar.
  */
  .pc-tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--accent);
    mix-blend-mode: screen;
    opacity: 0;
    transition: opacity .5s var(--ease-out-soft);
    pointer-events: none;
  }
  .project-card:hover .pc-tint,
  .project-card:focus-within .pc-tint { opacity: 0.3; }

  /* Pincelada de color que aparece con el título. */
  .pc-stroke {
    display: block;
    width: 52px;
    height: 5px;
    margin-bottom: 12px;
    border-radius: 6px 8px 7px 5px / 5px 7px 6px 8px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .45s var(--ease-out-soft) .1s;
  }
  .project-card:hover .pc-stroke,
  .project-card:focus-within .pc-stroke { transform: scaleX(1); }

  /* La pincelada: el overlay entra con un corte diagonal, no en horizontal. */
  .pc-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 26px;
    background: linear-gradient(0deg, rgba(0,0,0,0.72) 0%, transparent 55%);
    clip-path: polygon(0 100%, 100% 100%, 100% 100%, 0% 100%);
    transition: clip-path .5s var(--ease-in-out-firm);
  }
  .project-card:hover .pc-overlay,
  .project-card:focus-within .pc-overlay {
    clip-path: polygon(0 100%, 100% 100%, 100% 0%, 0% 20%);
  }

  .pc-title { font-family: var(--serif); font-size: 1.2rem; margin-bottom: 6px; color: var(--gesso); }
  .pc-tags { font-size: 0.74rem; color: #d8d3c9; }

  @media (max-width: 700px) {
    .projects { padding: 72px 0; }
    .pc-overlay { padding: 14px; }
    .pc-title { font-size: 0.98rem; }
    .pc-tags { font-size: 0.66rem; }
    .pc-stroke { width: 34px; height: 4px; margin-bottom: 8px; }
  }

  /* En táctil no hay hover: la información se muestra siempre. */
  @media (hover: none) {
    .pc-overlay { clip-path: polygon(0 100%, 100% 100%, 100% 0%, 0% 20%); }
    .pc-stroke { transform: scaleX(1); }
  }
</style>
