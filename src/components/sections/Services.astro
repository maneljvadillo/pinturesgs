---
/**
 * SERVICIOS — 9 categorías con foto de fondo y sus subfaenas concretas
 * como etiquetas. Las etiquetas que no caben se pliegan tras un "+N ver más".
 *
 * Se renderiza en el servidor: el texto de los servicios es contenido real y
 * debe estar en el HTML, no montarse con JavaScript.
 */
import { Image } from 'astro:assets';
import { SERVICES, VISIBLE_TAGS } from '~/data/services';
import { photoSrc, photoAlt } from '~/lib/photos';

/**
 * Cada servicio se pinta de un color de la marca. Es una rotación fija (no
 * aleatoria) para que el orden sea siempre el mismo entre visitas y entre
 * servidor y cliente.
 */
const ACCENTS = ['red', 'orange', 'yellow', 'green', 'turq', 'blue', 'purple', 'pink'];
---

<section class="services" id="servicios">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Servicios</span>
      <h2>Todo tipo de pintura.<br />Todo tipo de proyectos.</h2>
    </div>

    <ul class="services-grid">
      {SERVICES.map((s, si) => {
        const img = photoSrc(s.photo);
        const visible = s.tasks.slice(0, VISIBLE_TAGS);
        const hidden = s.tasks.slice(VISIBLE_TAGS);
        const tagsId = `st-tags-${si}`;
        const accent = ACCENTS[si % ACCENTS.length];
        return (
          <li
            class="service-tile grain"
            data-reveal
            style={`--accent: var(--c-${accent}); --reveal-i: ${si % 3};`}
          >
            {img ? (
              <Image
                class="st-bg"
                src={img}
                alt={photoAlt(s.photo)}
                widths={[400, 700, 900]}
                sizes="(max-width: 560px) 100vw, (max-width: 900px) 50vw, 33vw"
                loading="lazy"
                decoding="async"
              />
            ) : (
              <div class="st-bg st-bg--fallback" aria-hidden="true"></div>
            )}

            <span class="st-tint" aria-hidden="true"></span>

            <div class="st-content">
              <h3 class="st-name">{s.name}</h3>
              <div class="st-tags-wrap">
                <div class="st-tags" id={tagsId}>
                  {visible.map((t) => <span class="tag-chip">{t}</span>)}
                  {hidden.map((t) => <span class="tag-chip">{t}</span>)}
                </div>
                {hidden.length > 0 && (
                  <button
                    type="button"
                    class="tag-more"
                    data-target={tagsId}
                    data-count={hidden.length}
                    aria-expanded="false"
                    aria-controls={tagsId}
                  >
                    +{hidden.length} ver más
                  </button>
                )}
              </div>
            </div>
          </li>
        );
      })}
    </ul>

  </div>
</section>

<style>
  .services {
    --accent: var(--c-turq);
    padding: var(--section-y) 0 100px;
    background: var(--gesso);
  }
  @media (max-width: 700px) { .services { padding: 72px 0 60px; } }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3px;
    list-style: none;
  }
  /*
    Dos columnas también en el móvil. A una columna, nueve servicios cuadrados
    sumaban más de cuatro pantallas de alto ellos solos: la mitad de la página
    era esta rejilla y no se llegaba nunca a lo de abajo.
  */
  @media (max-width: 900px) { .services-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .services-grid { gap: 2px; } }

  .service-tile {
    position: relative;
    aspect-ratio: 1 / 1;
    color: #fff;
    overflow: hidden;
    background: #2a2925;
  }

  /*
    Franja de color al pie de cada servicio: es lo que hace que la rejilla se
    lea como una paleta y no como nueve fotos oscuras. Al pasar por encima
    crece, como una pincelada que se carga más.
  */
  .service-tile::after {
    content: '';
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 5px;
    background: var(--accent);
    z-index: 3;
    transform-origin: bottom;
    transition: height .35s var(--ease-out-soft);
  }
  .service-tile:hover::after,
  .service-tile:focus-within::after { height: 11px; }

  /* Baño de color sobre la foto al pasar por encima. `multiply` mantiene el
     detalle de la imagen en vez de taparla con un plano de color. */
  .st-tint {
    position: absolute;
    inset: 0;
    z-index: 1;
    background: var(--accent);
    mix-blend-mode: multiply;
    opacity: 0;
    transition: opacity .45s var(--ease-out-soft);
    pointer-events: none;
  }
  .service-tile:hover .st-tint,
  .service-tile:focus-within .st-tint { opacity: 0.42; }

  .st-bg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform .6s var(--ease-out-soft);
  }
  .service-tile:hover .st-bg { transform: scale(1.07); }

  /* Si todavía no hay foto, un degradado de marca en vez de un hueco negro. */
  .st-bg--fallback {
    background:
      radial-gradient(circle at 30% 20%, var(--c-turq), transparent 60%),
      radial-gradient(circle at 75% 70%, var(--c-purple), transparent 62%),
      var(--ink);
    filter: saturate(1.3);
  }

  .st-content {
    position: absolute;
    inset: 0;
    padding: 26px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    z-index: 2;
  }
  .st-content::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgba(0,0,0,0.75) 0%, rgba(0,0,0,0.15) 55%, transparent 75%);
    z-index: -1;
  }

  .st-name {
    font-family: var(--serif);
    font-size: clamp(1.1rem, 2vw, 1.6rem);
    margin-bottom: 8px;
    color: #fff;
  }

  /*
    El botón "+N ver más" va FUERA de la caja que se pliega. Dentro se quedaba
    en la segunda fila de etiquetas, que está oculta, y no había forma de saber
    que quedaban subfaenas por ver.
  */
  .st-tags-wrap { display: flex; flex-direction: column; align-items: flex-start; gap: 7px; }

  .st-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    max-height: 26px;
    overflow: hidden;
    transition: max-height .35s ease;
  }
  .st-tags.expanded { max-height: 200px; }

  .tag-chip {
    font-size: 0.68rem;
    padding: 3px 10px;
    border: 1px solid rgba(255, 255, 255, 0.55);
    border-radius: 20px;
    white-space: nowrap;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
    transition: border-color .3s ease, background .3s ease;
  }
  .service-tile:hover .tag-chip { border-color: rgba(255, 255, 255, 0.9); }

  .tag-more {
    font-size: 0.68rem;
    padding: 3px 10px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.92);
    color: var(--ink);
    cursor: pointer;
    font-weight: 600;
    white-space: nowrap;
    border: none;
  }
  .tag-more:hover { background: #fff; }

  /* Con la tarjeta a media pantalla, el interior tiene que encoger. */
  @media (max-width: 560px) {
    .st-content { padding: 14px; }
    .st-name { font-size: 1rem; margin-bottom: 6px; }
    .tag-chip, .tag-more { font-size: 0.62rem; padding: 2px 8px; }
    .st-tags { max-height: 22px; }
    .service-tile::after { height: 4px; }
  }
</style>

<script>
  // Plegar/desplegar las subfaenas que no caben.
  document.querySelectorAll<HTMLButtonElement>('.tag-more').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = document.getElementById(btn.dataset.target!);
      if (!target) return;
      const expanded = target.classList.toggle('expanded');
      btn.setAttribute('aria-expanded', String(expanded));
      btn.textContent = expanded ? 'ver menos' : `+${btn.dataset.count} ver más`;
    });
  });
</script>
