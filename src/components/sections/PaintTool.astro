---
/**
 * "PINTA EL TEU ESPAI" — dos tarjetas: Antes/Después y Paleta.
 *
 * La sala llega con CUATRO ZONAS ya marcadas —pared izquierda, del fondo,
 * tabique derecho y techo—,
 * cada una con su máscara real generada en build (scripts/build-wall-masks.mjs)
 * cada una con su máscara real y su propio sombreado. Con cuatro planos se
 * puede ensayar una combinación entera, que es lo que de verdad se decide al
 * pintar una casa: no un color suelto, sino cómo quedan juntos.
 *
 * Si el usuario quiere pintar algo más (un techo, un hueco), lo señala él
 * arrastrando un rectángulo: NO hay detección automática de zonas nuevas, eso
 * exigiría una API externa de segmentación (ver docs/MEJORAS-FUTURAS.md).
 *
 * La paleta y las combinaciones se renderizan en el servidor: son 272 muestras
 * y montarlas con JavaScript retrasaría la interacción sin ninguna ventaja.
 */
import { getImage } from 'astro:assets';
import sala from '~/assets/photos/sala-tres-paredes.jpg';
import { PALETTE, COMBOS } from '~/data/palette';
import { PHOTO_BY_KEY } from '~/data/photos';

const photoMeta = PHOTO_BY_KEY['sala-tres-paredes']!;

// La misma URL para el <img> del "antes" y para el lienzo: un solo descargue.
const salaImg = await getImage({ src: sala, width: sala.width, format: 'webp', quality: 88 });

/**
 * Cuántas combinaciones se ven sin desplegar.
 *
 * Eran cuatro porque la paleta entera vivía en esta misma columna y con las
 * diez a la vista la tarjeta quedaba cargadísima. Ahora la paleta está abajo,
 * a lo ancho, y esta columna sólo lleva las combinaciones: caben las diez y
 * además son las que rellenan el alto de la foto de al lado.
 */
const VISIBLE_COMBOS = COMBOS.length;

/**
 * Cuántas FAMILIAS de color se ven sin desplegar.
 *
 * Son veinte familias y 272 muestras: puestas todas, sólo la paleta medía casi
 * una pantalla en escritorio y el triple en móvil, donde las familias van en
 * una sola columna. Con seis se ve una carta de colores de verdad —dos por
 * columna— y quien quiera más las pide.
 *
 * Las seis primeras son las de la lista: blancos, negros, grises, beiges,
 * marrones y rojos. Es decir, los neutros primero, que es por donde empieza
 * cualquiera que esté eligiendo un color para una pared.
 */
const VISIBLE_GROUPS = 6;

const TOOLS = [
  { id: 'rellenar', emoji: '🪣', label: 'Rellenar', hint: 'Pinta la zona entera de una vez' },
  { id: 'brocha',   emoji: '🖌️', label: 'Brocha',   hint: 'Traza fino, para retocar' },
  { id: 'rodillo',  emoji: '🧻', label: 'Rodillo',  hint: 'Traza ancho' },
  { id: 'borrar',   emoji: '🩹', label: 'Borrar',   hint: 'Quita pintura y deja el color original' },
];
---

<section
  class="paint-tool"
  id="pinta"
  data-photo={salaImg.src}
  data-mask="/room/sala-paredes.png"
  data-mask-ceiling="/room/sala-techo.png"
  data-w={sala.width}
  data-h={sala.height}
>
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Herramienta interactiva</span>
      <h2>Pinta el teu espai</h2>
      <p>
        Tres paredes y el techo, cada uno con su luz y sus sombras. Pinta cada zona de un
        color, prueba una combinación entera y mira cómo queda antes de decidir nada.
      </p>
    </div>

    <div class="toolbar" role="toolbar" aria-label="Herramientas de pintura">
      <div class="tool-group" role="radiogroup" aria-label="Herramienta activa">
        {TOOLS.map((t, i) => (
          <button
            type="button"
            class:list={['tool-btn', { active: i === 0 }]}
            data-tool={t.id}
            role="radio"
            aria-checked={i === 0 ? 'true' : 'false'}
            title={t.hint}
          >
            <span aria-hidden="true">{t.emoji}</span> {t.label}
          </button>
        ))}
      </div>

      <span class="tool-spacer"></span>

      <div class="tool-group">
        <button type="button" class="tool-btn" id="undoBtn" disabled>↶ Deshacer</button>
        <button type="button" class="tool-btn" id="redoBtn" disabled>↷ Rehacer</button>
        <button type="button" class="tool-btn" id="resetBtn">⟲ Restablecer</button>
      </div>
    </div>

    <div class="pt-row">
      <!-- ── Tarjeta 1: antes / después ──────────────────────────────── -->
      <div class="pt-card">
        <h3>Antes / Después</h3>
        <p class="pt-card-sub">
          Las tres paredes y el techo están detectados: elige una zona arriba (o haz clic
          sobre ella) y dale color con la paleta. ¿Quieres pintar alguna zona más? Márcala
          con “➕ Marcar otra pared”. Arrastra el control para comparar con el antes.
        </p>

        <div class="stage-frame" id="stage">
          <img
            class="room-before"
            src={salaImg.src}
            width={sala.width}
            height={sala.height}
            alt={photoMeta.alt}
            loading="lazy"
            decoding="async"
          />
          <div class="room-after" id="roomAfter">
            <canvas id="paintCanvas" width={sala.width} height={sala.height} role="img"
              aria-label="Vista de la sala con los colores que vas aplicando"></canvas>
          </div>

          <!--
            Capa de interacción, fuera del recorte del comparador: así se puede
            seguir pintando esté donde esté el deslizador.
          -->
          <div class="region-layer" id="regionLayer"></div>

          <!--
            La brocha. Va FUERA de la capa de interacción —el ratón no debe
            poder tocarla nunca— y por encima de todo lo demás del marco.
          -->
          <span class="brush-dot" id="brushDot" aria-hidden="true"></span>

          <div class="compare-handle" id="compareHandle" aria-hidden="true"></div>

          <button type="button" class="mark-btn" id="markBtn" aria-pressed="false">
            ➕ Marcar otra pared
          </button>
          <p class="photo-hint" id="photoHint" hidden>
            Arrastra un rectángulo sobre la zona que quieras pintar
          </p>
          <p class="stage-loading" id="stageLoading">Preparando la pared…</p>
        </div>

        <label class="compare-control">
          <span class="sr-only">Comparar antes y después</span>
          <input type="range" min="0" max="100" value="50" class="compare-range" id="compareRange" />
        </label>
        <p class="room-caption">{photoMeta.alt}.</p>
      </div>

      <!-- ── Tarjeta 2: paleta ───────────────────────────────────────── -->
      <div class="pt-card">
        <h3>Paleta</h3>

        <p class="pt-card-sub">Diez combinaciones probadas — visten las cuatro zonas de una vez:</p>
        <div class="combo-row" id="comboRow">
          {COMBOS.map((c, i) => (
            <button
              type="button"
              class:list={['combo-btn', { extra: i >= VISIBLE_COMBOS }]}
              data-combo={c.colors.join(',')}
              data-name={c.name}
              title={`${c.name} — ${c.mood}`}
              aria-label={`Aplicar la combinación ${c.name}: ${c.mood}`}
            >
              <span class="combo-dots" aria-hidden="true">
                {c.colors.map((hex) => <span class="combo-dot" style={`background:${hex}`}></span>)}
              </span>
              <span class="combo-text">
                <span class="combo-name">{c.name}</span>
                <span class="combo-mood">{c.mood}</span>
              </span>
            </button>
          ))}
        </div>

        <p class="pt-card-sub">O zona a zona. Zona seleccionada:</p>
        <div class="wall-picker" id="wallPicker"></div>

        <!--
          El nombre y el código NO van debajo de cada muestra: van aquí, en una
          sola línea, para el color que se está señalando. Con más de doscientos
          colores, repetir el rótulo en cada uno obligaba a hacer las muestras
          grandes —cuatro por fila— y a recortar los nombres largos igualmente.
          Así caben trece por fila y el nombre se lee entero.

          Sigue siendo información visual: cada botón lleva su `aria-label` con
          el nombre, así que un lector de pantalla ya lo dice sin esta línea.
        -->

      </div>
    </div>

    <!--
      La paleta completa, a lo ancho y fuera de la columna de la derecha.

      Estaba metida ahí dentro (471 px) con su propio scroll, y eso hacía dos
      cosas mal a la vez: obligaba a rebuscar los colores por una mirilla de
      cuatro columnas, y estiraba esa tarjeta 195 px más que la de la imagen,
      dejando un hueco enorme justo debajo de la foto.

      A lo ancho caben muchas más muestras por fila, se ve todo de un vistazo y
      desaparece el scroll dentro de una caja.
    -->
    <div class="pt-card pt-paleta">
      <h3>Todos los colores</h3>

      <p class="swatch-readout" id="swatchReadout" aria-hidden="true">
        <span class="ro-sq"></span>
        <span class="ro-text">Señala un color para ver su nombre</span>
      </p>

      <div class="palette-scroll" id="paletteScroll">
        {PALETTE.map((group, i) => (
          <div class:list={['palette-group', { extra: i >= VISIBLE_GROUPS }]}>
            <h4>{group.group}</h4>
            <div class="swatch-grid">
              {group.colors.map((c) => (
                <button
                  type="button"
                  class="swatch-cell"
                  data-hex={c.hex}
                  data-name={c.name}
                  title={`${c.name} · ${c.hex}`}
                  aria-label={`Aplicar ${c.name}`}
                  style={`background:${c.hex}`}
                ></button>
              ))}
            </div>
          </div>
        ))}
      </div>

      <button
        type="button"
        class="palette-more"
        id="paletteMore"
        aria-expanded="false"
        aria-controls="paletteScroll"
      >
        Ver más colores <span class="pm-n">({PALETTE.length - VISIBLE_GROUPS} familias más)</span>
      </button>
    </div>
  </div>
</section>

<style>
  .paint-tool {
    --accent: var(--c-purple);
    padding: var(--section-y) 0;
    background: #EFEDE7;
  }

  /* ── Barra de herramientas ────────────────────────────────────────── */
  .toolbar { display: flex; gap: 6px; margin-bottom: 18px; flex-wrap: wrap; align-items: center; }
  .tool-group { display: flex; gap: 6px; flex-wrap: wrap; }
  .tool-spacer { flex: 1; min-width: 12px; }

  .tool-btn {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 12px;
    border: 1px solid var(--control-border);
    background: #fff;
    border-radius: 4px;
    font-size: 0.76rem;
    cursor: pointer;
    transition: background .2s ease, color .2s ease, border-color .2s ease, opacity .2s ease;
  }
  .tool-btn:hover:not(:disabled) { border-color: var(--ink); }
  .tool-btn.active { background: var(--ink); color: #fff; border-color: var(--ink); }
  .tool-btn:disabled { opacity: 0.35; cursor: not-allowed; }

  /* ── Tarjetas ─────────────────────────────────────────────────────── */
  /*
    `stretch` y no `start`: las dos tarjetas miden lo mismo de alto aunque su
    contenido no dé para tanto. Con `start`, la más corta terminaba antes y
    dejaba un escalón a su lado — que es justo lo que pasaba debajo de la foto.
  */
  .pt-row {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 22px;
    align-items: stretch;
  }
  @media (max-width: 1100px) { .pt-row { grid-template-columns: 1fr; } }

  /* Filete de color arriba de cada tarjeta, como en el resto de la web. */
  .pt-card {
    position: relative;
    background: #fff;
    border: 1px solid var(--stone-light);
    border-radius: 10px;
    padding: 18px;
    overflow: hidden;
  }
  .pt-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0;
    height: 4px;
    background: var(--rainbow-line);
  }
  .pt-card h3 { font-family: var(--display); font-size: 1.05rem; margin-bottom: 4px; }

  /*
    La columna de la derecha en vertical, para que la lista de combinaciones
    pueda quedarse con el alto sobrante en vez de dejarlo en blanco al final.
  */
  .pt-row > .pt-card:last-child { display: flex; flex-direction: column; }

  /* La paleta completa, a lo ancho y debajo de las dos. */
  .pt-paleta { margin-top: 22px; }
  .pt-card-sub { font-size: 0.76rem; color: var(--stone); margin-bottom: 14px; line-height: 1.5; }

  /* ── Escenario ────────────────────────────────────────────────────── */
  .stage-frame {
    position: relative;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid var(--stone-light);
    background: #F6F4EF;
    /* Se ajusta a la foto real para no recortarla ni deformarla. */
    aspect-ratio: 1200 / 896;
    touch-action: pan-y;
  }
  .room-before, .room-after, .region-layer {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .room-before { object-fit: cover; }
  .room-after { clip-path: inset(0 50% 0 0); }
  .room-after canvas { width: 100%; height: 100%; display: block; }

  /* Capa de interacción: siempre por encima y sin recortar. */
  .region-layer { z-index: 3; }

  .compare-handle {
    position: absolute;
    top: 0; bottom: 0; left: 50%;
    width: 2px;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.15);
    pointer-events: none;
    z-index: 4;
  }
  .compare-handle::after {
    content: '◂▸';
    position: absolute;
    top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    background: #fff;
    color: var(--ink);
    font-size: 0.7rem;
    padding: 6px 8px;
    border-radius: 20px;
    letter-spacing: 2px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .compare-control { display: block; }
  .compare-range { width: 100%; margin-top: 14px; accent-color: var(--terracotta); }

  .room-caption { font-size: 0.74rem; color: var(--stone); margin-top: 10px; }
  .pt-card .placeholder-note { margin-top: 4px; }

  .mark-btn {
    position: absolute;
    bottom: 10px; right: 10px;
    z-index: 5;
    font-size: 0.72rem;
    padding: 8px 13px;
    border-radius: 20px;
    background: #fff;
    border: 1px solid var(--control-border);
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
    transition: background .2s ease, color .2s ease, border-color .2s ease;
  }
  .mark-btn[aria-pressed='true'] { background: var(--terracotta); color: #fff; border-color: var(--terracotta); }

  .photo-hint, .stage-loading {
    position: absolute;
    bottom: 10px; left: 10px;
    z-index: 5;
    font-size: 0.66rem;
    background: rgba(255, 255, 255, 0.92);
    padding: 5px 10px;
    border-radius: 20px;
    color: var(--stone);
    max-width: 60%;
  }
  .stage-loading { top: 10px; bottom: auto; }

  /* ── Selector de zona ─────────────────────────────────────────────── */
  .wall-picker { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }

  /* ── Paleta ───────────────────────────────────────────────────────── */
  /* Sin `max-height` ni scroll: a lo ancho cabe entera y se ve de un vistazo. */
  .palette-scroll { margin-top: 4px; }
  /*
    Los grupos de color se reparten en columnas. Con 1200 px de ancho, ponerlos
    uno debajo de otro dejaba una fila larguísima por grupo y mucho aire a los
    lados; en columnas se leen como una carta de colores.
  */
  .palette-scroll {
    columns: 3;
    column-gap: 26px;
  }
  @media (max-width: 900px) { .palette-scroll { columns: 2; } }
  @media (max-width: 560px) { .palette-scroll { columns: 1; } }
  .palette-group {
    margin-bottom: 16px;
    /* Que un grupo no se parta entre dos columnas. */
    break-inside: avoid;
  }
  /* Las familias de más allá del corte. `display: none` y no `visibility`
     para que además salgan del recorrido del tabulador estando plegadas. */
  .palette-group.extra { display: none; }
  .palette-scroll.expanded .palette-group.extra { display: block; }

  .palette-more {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    padding: 9px 18px;
    border: 1px solid var(--control-border);
    border-radius: 20px;
    background: transparent;
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;
    transition: border-color .25s ease, background .25s ease;
  }
  .palette-more:hover, .palette-more:focus-visible {
    border-color: var(--ink);
    background: rgba(0, 0, 0, 0.03);
  }
  .palette-more .pm-n { color: var(--stone); }
  .palette-group h4 {
    font-family: var(--sans);
    font-size: 0.68rem;
    font-weight: 500;
    margin-bottom: 7px;
    color: var(--stone);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /*
    ── LAS MUESTRAS ────────────────────────────────────────────────────
    Muestras pequeñas y muchas. Antes eran cuatro por fila porque cada una
    cargaba con su nombre y su código debajo, y los nombres largos no cabían de
    otra manera; con la carta entera —más de doscientos colores— eso era una
    lista interminable. Ahora el rótulo se ha ido a una sola línea arriba
    (`.swatch-readout`) y la muestra es sólo color.

    `auto-fill` con un mínimo de 28 px: caben las que quepan en el ancho que
    haya, sin una consulta de medios por cada tamaño de tarjeta. Y 28 px no es
    un número redondo cualquiera — la WCAG 2.2 pide 24x24 px de zona pulsable
    como mínimo, así que por debajo de ahí no se puede bajar por mucho que se
    quieran meter más colores por fila.
  */
  .swatch-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(28px, 1fr));
    gap: 6px;
  }

  .swatch-cell {
    cursor: pointer;
    aspect-ratio: 1 / 1;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 5px;
    /* El filete interior despega del fondo a los blancos y a los cremas, que
       si no parecen huecos en la rejilla. */
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12);
    transition: transform .15s ease, border-color .15s ease;
  }
  .swatch-cell:hover,
  .swatch-cell:focus-visible { transform: scale(1.18); z-index: 1; }
  .swatch-cell.active {
    border-color: var(--ink);
    transform: scale(1.18);
    /* El aro blanco separa el borde negro del color de al lado: sobre una
       rejilla apretada, sin él no se distingue cuál está elegido. */
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.9);
  }

  /*
    Quien llega aquí viene a por el color: si le gusta uno tiene que poder
    decir "quiero el Verde Selva, el #1E3A2F" por teléfono. El nombre y el
    código siguen a la vista, pero del color SEÑALADO, no de los doscientos a
    la vez.
  */
  .swatch-readout {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 26px;
    margin-bottom: 9px;
    font-size: 0.72rem;
    color: var(--ink);
  }
  .swatch-readout .ro-sq {
    width: 16px; height: 16px;
    flex: none;
    border-radius: 4px;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.18);
    background: transparent;
    /* Sin color señalado no hay cuadrito: sólo el texto de ayuda. */
    display: none;
  }
  .swatch-readout.on .ro-sq { display: block; }
  .swatch-readout .ro-hex {
    color: var(--stone);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
  }

  /* ── Combinaciones ────────────────────────────────────────────────── */
  /*
    `flex: 1` para que esta lista absorba el alto que le sobre a la columna:
    así la tarjeta llega justo hasta donde acaba la foto de al lado en vez de
    dejar un hueco al final. `grid-auto-rows: 1fr` reparte ese alto entre las
    filas, de modo que las combinaciones crecen un poco y quedan más cómodas
    de pulsar en vez de amontonarse arriba.
  */
  .combo-row {
    flex: 1;
    grid-auto-rows: 1fr;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 8px;
    margin-bottom: 18px;
  }
  .combo-btn {
    display: flex;
    align-items: center;
    gap: 9px;
    padding: 8px 10px;
    border: 1px solid var(--stone-light);
    border-radius: 8px;
    background: #fff;
    cursor: pointer;
    text-align: left;
    min-width: 0;
    transition: border-color .25s ease, transform .25s var(--ease-out-soft), box-shadow .25s ease;
  }
  .combo-btn:hover, .combo-btn:focus-visible {
    border-color: var(--control-border);
    transform: translateY(-2px);
    box-shadow: 0 8px 18px rgba(0, 0, 0, 0.07);
  }
  .combo-btn.active { border-color: var(--ink); }

  /* Las tres muestras, en el mismo orden que las zonas. */
  .combo-dots { display: flex; gap: 2px; flex: none; }
  .combo-dot {
    width: 15px; height: 26px;
    border-radius: 3px;
    border: 1px solid rgba(0, 0, 0, 0.10);
  }
  /* La tercera muestra es el plano de cierre y siempre va clara: se marca algo
     más estrecha para que se lea como acompañamiento, no como protagonista. */
  .combo-dot:last-child { width: 10px; }

  .combo-text { display: flex; flex-direction: column; min-width: 0; }


  .combo-name { font-size: 0.78rem; font-weight: 500; line-height: 1.25; }
  .combo-mood {
    font-size: 0.64rem;
    color: var(--stone);
    line-height: 1.25;
    /* Una sola línea: con diez combinaciones, dos líneas alargaban la tarjeta
       de la paleta más que la propia paleta. */
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  @media (max-width: 480px) {
    .combo-mood { display: none; }
    .combo-dot { height: 22px; }
  }


</style>

<!--
  Estilos de los elementos que crea el script (chips de zona, etiquetas y
  rectángulo de marcado). Van en un bloque global porque Astro sólo aplica el
  ámbito a lo que existe en el HTML renderizado.
-->
<style is:global>
  .paint-tool .wall-chip {
    padding: 6px 13px;
    border: 1px solid var(--control-border);
    border-radius: 20px;
    font-size: 0.76rem;
    cursor: pointer;
    background: transparent;
    transition: border-color .25s ease, color .25s ease;
    display: inline-flex;
    align-items: center;
    gap: 7px;
  }
  .paint-tool .wall-chip:hover { border-color: var(--ink); }
  .paint-tool .wall-chip.active { border-color: var(--terracotta); color: var(--terracotta); font-weight: 500; }
  /* El color aplicado se dice con su nombre, no sólo con el punto. */
  .paint-tool .wall-chip .chip-color { color: var(--stone); }
  .paint-tool .wall-chip.active .chip-color { color: inherit; opacity: 0.75; }

  .paint-tool .wall-chip .chip-dot {
    width: 11px; height: 11px;
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.18);
  }
  .paint-tool .wall-chip .chip-dot.empty {
    background: repeating-linear-gradient(45deg, #ddd 0 3px, #fff 3px 6px);
  }

  /* Etiqueta flotante de cada zona sobre la foto. */
  .paint-tool .region-tag {
    position: absolute;
    transform: translate(-50%, -50%);
    background: rgba(22, 21, 19, 0.82);
    color: #fff;
    font-size: 0.62rem;
    padding: 3px 8px;
    border-radius: 20px;
    pointer-events: none;
    white-space: nowrap;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }
  .paint-tool .region-tag.selected { background: var(--terracotta); }

  /*
    En el móvil el marco mide poco más de 300 px: con tres etiquetas del mismo
    tamaño que en escritorio, la del tabique se salía por la derecha. Se
    encogen y se les impide desbordar el marco.
  */
  @media (max-width: 700px) {
    .paint-tool .region-tag {
      font-size: 0.54rem;
      padding: 2px 6px;
      max-width: 44%;
      overflow: hidden;
      text-overflow: ellipsis;
    }
  }

  /* Rectángulo que el usuario está arrastrando. */
  .paint-tool .draw-preview {
    position: absolute;
    border: 2px dashed var(--terracotta);
    background: rgba(193, 80, 46, 0.15);
    pointer-events: none;
  }
  .paint-tool .region-layer.marking { cursor: crosshair; }
  .paint-tool .region-layer.painting { cursor: none; }

  /*
    ── QUE EL DEDO PINTE Y NO ARRASTRE LA PÁGINA ───────────────────────
    `.stage-frame` deja pasar el desplazamiento vertical (`pan-y`), que es lo
    que se quiere con el cubo: se toca para rellenar, y el resto del tiempo la
    foto no debe secuestrar el dedo de quien sólo está bajando por la página.

    Pero con la brocha, el rodillo o la goma el gesto ES arrastrar, y `pan-y`
    se lo llevaba el navegador: en el móvil la página subía y bajaba en lugar
    de pintar. Con una herramienta de trazo activa —o marcando una pared— el
    marco se queda el gesto entero. Del navegador para arriba se cruzan los
    valores de toda la cadena, así que este `none` manda sobre el `pan-y` del
    padre.

    Se sigue pudiendo bajar por la página desde cualquier punto FUERA de la
    foto, y volviendo al cubo se recupera el desplazamiento también encima.
  */
  .paint-tool .region-layer.painting,
  .paint-tool .region-layer.marking { touch-action: none; }

  /*
    ── LA BROCHA ───────────────────────────────────────────────────────
    Con una herramienta de trazo activa el puntero del sistema se esconde
    (`cursor: none`) y hasta ahora no lo sustituía NADA: no se veía dónde ni
    de qué grosor se iba a pintar. Con el dedo era peor todavía, porque encima
    lo tapa la propia mano.

    Es un aro del color que se va a aplicar, del tamaño exacto del trazo, con
    filete blanco por dentro y oscuro por fuera para que se vea igual sobre
    una pared clara que sobre una oscura, y un punto en el centro que marca el
    píxel exacto. `--bd-size` (el diámetro) y `--bd-color` los pone el script.

    Sólo se mueve con `transform`, así que seguir al puntero no cuesta nada.
  */
  .paint-tool .brush-dot {
    position: absolute;
    top: 0; left: 0;
    z-index: 6;
    pointer-events: none;
    width: var(--bd-size, 40px);
    height: var(--bd-size, 40px);
    margin: calc(var(--bd-size, 40px) / -2) 0 0 calc(var(--bd-size, 40px) / -2);
    border-radius: 50%;
    border: 2px solid var(--bd-color, #fff);
    background: color-mix(in srgb, var(--bd-color, #fff) 26%, transparent);
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.5), inset 0 0 0 1px rgba(255, 255, 255, 0.9);
    opacity: 0;
    transition: opacity .12s ease;
    will-change: transform;
  }
  .paint-tool .brush-dot.show { opacity: 1; }
  /* La goma no pinta de ningún color: aro discontinuo y sin relleno. */
  .paint-tool .brush-dot.erase {
    border-style: dashed;
    border-color: #fff;
    background: none;
  }
  .paint-tool .brush-dot::after {
    content: '';
    position: absolute;
    top: 50%; left: 50%;
    width: 3px; height: 3px;
    margin: -1.5px 0 0 -1.5px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.55);
  }
</style>

<script>
  import { initPaintTool } from '~/scripts/paint-tool/index';
  initPaintTool();
</script>
