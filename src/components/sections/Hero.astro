---
/**
 * HERO — "una capa blanca que esconde un mundo de color debajo".
 *
 * Tres capas apiladas:
 *   0. .hero-color-layer  paleta multicolor saturada, con deriva continua.
 *   1. canvas#heroReveal  la capa blanca. El puntero la va borrando con una
 *                         línea fina que se cicatriza sola en ~320 ms.
 *   2. .hero-inner        el mensaje y el logotipo, siempre por encima.
 */
import Logo from '~/components/Logo.astro';
import BrushCursor from '~/components/BrushCursor.astro';
import { LOGOS, DEFAULT_LOGO } from '~/lib/logo';
import { SITE } from '~/data/site';

/* El brillo de pintura húmeda se recorta con la silueta del propio logotipo:
   sin esto sería una banda blanca rectangular cruzando el aire. */
const logoMask = LOGOS[DEFAULT_LOGO].src;
---

<section class="hero brush-zone" id="top">
  <!--
    El cursor de brocha se monta desde el hero a propósito: así no existe en
    las demás páginas ni por debajo de las demás secciones.
  -->
  <BrushCursor />

  <div class="hero-color-layer" aria-hidden="true"></div>

  <!--
    La capa blanca es un <canvas>, no una máscara CSS. El prototipo exportaba
    el canvas a data-URL 25 veces por segundo para usarlo como mask-image, lo
    que costaba un PNG completo por fotograma. Pintando el blanco directamente
    en el canvas y borrándolo con destination-out el resultado es idéntico y
    el coste, prácticamente cero.
  -->
  <canvas class="hero-white-layer" id="heroReveal" aria-hidden="true"></canvas>

  <div class="wrap hero-inner">
    <div class="hero-copy">
      <h1 class="hero-message">No solo pintamos.<br />Transformamos espacios.</h1>
      <p class="hero-sub">
        Profesionales de la pintura para particulares, empresas y grandes proyectos.
        Interior, exterior, altura, parkings, metal, barnices y mucho más.
      </p>
      <div class="hero-ctas">
        <a href="#presupuesto" class="btn-paint">Pedir presupuesto</a>
        <a href="#proyectos" class="btn-ghost">Ver proyectos</a>
      </div>
    </div>

    <div class="hero-gs">
      <div class="hero-gs-inner" style={`--logo-mask: url("${logoMask}");`}>
        <Logo width={520} eager alt={`${SITE.name}`} />
        <span class="hero-gs-gloss" aria-hidden="true"><span class="gloss-band"></span></span>
      </div>
    </div>
  </div>

  <div class="scroll-cue" aria-hidden="true">Descubre más</div>
</section>

<style>
  .hero {
    min-height: 100svh;
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 130px 0 90px;
    overflow: hidden;
  }

  /* ── Capa 0: el color de debajo ───────────────────────────────────── */
  .hero-color-layer {
    position: absolute;
    /*
      Se sale del hero por los cuatro lados: la deriva mueve la capa entera y
      este margen evita que asome un borde sin pintar.
    */
    inset: -18%;
    z-index: 0;
    /*
      Campo de color denso. Los círculos son pequeños y se solapan a propósito:
      así cualquier trazo, por corto que sea, descubre varios colores a la vez
      en lugar de una mancha plana de un solo tono.
    */
    background:
      radial-gradient(circle at 6% 10%,  var(--c-red)    0%, var(--c-red)    9%,  transparent 22%),
      radial-gradient(circle at 20% 4%,  var(--c-orange) 0%, var(--c-orange) 8%,  transparent 20%),
      radial-gradient(circle at 33% 14%, var(--c-yellow) 0%, var(--c-yellow) 9%,  transparent 21%),
      radial-gradient(circle at 47% 5%,  var(--c-green)  0%, var(--c-green)  8%,  transparent 20%),
      radial-gradient(circle at 60% 15%, var(--c-turq)   0%, var(--c-turq)   9%,  transparent 21%),
      radial-gradient(circle at 74% 6%,  var(--c-blue)   0%, var(--c-blue)   8%,  transparent 20%),
      radial-gradient(circle at 88% 14%, var(--c-purple) 0%, var(--c-purple) 9%,  transparent 22%),
      radial-gradient(circle at 97% 30%, var(--c-pink)   0%, var(--c-pink)   9%,  transparent 21%),
      radial-gradient(circle at 12% 30%, var(--c-yellow) 0%, var(--c-yellow) 8%,  transparent 20%),
      radial-gradient(circle at 27% 38%, var(--c-pink)   0%, var(--c-pink)   8%,  transparent 20%),
      radial-gradient(circle at 42% 30%, var(--c-blue)   0%, var(--c-blue)   9%,  transparent 21%),
      radial-gradient(circle at 56% 40%, var(--c-orange) 0%, var(--c-orange) 8%,  transparent 20%),
      radial-gradient(circle at 71% 31%, var(--c-green)  0%, var(--c-green)  9%,  transparent 21%),
      radial-gradient(circle at 85% 42%, var(--c-red)    0%, var(--c-red)    8%,  transparent 20%),
      radial-gradient(circle at 4% 52%,  var(--c-turq)   0%, var(--c-turq)   9%,  transparent 21%),
      radial-gradient(circle at 19% 62%, var(--c-purple) 0%, var(--c-purple) 8%,  transparent 20%),
      radial-gradient(circle at 34% 54%, var(--c-red)    0%, var(--c-red)    9%,  transparent 21%),
      radial-gradient(circle at 49% 64%, var(--c-turq)   0%, var(--c-turq)   8%,  transparent 20%),
      radial-gradient(circle at 63% 55%, var(--c-yellow) 0%, var(--c-yellow) 9%,  transparent 21%),
      radial-gradient(circle at 78% 66%, var(--c-blue)   0%, var(--c-blue)   8%,  transparent 20%),
      radial-gradient(circle at 93% 57%, var(--c-green)  0%, var(--c-green)  9%,  transparent 21%),
      radial-gradient(circle at 9% 80%,  var(--c-orange) 0%, var(--c-orange) 8%,  transparent 20%),
      radial-gradient(circle at 24% 90%, var(--c-blue)   0%, var(--c-blue)   9%,  transparent 21%),
      radial-gradient(circle at 39% 80%, var(--c-purple) 0%, var(--c-purple) 8%,  transparent 20%),
      radial-gradient(circle at 54% 91%, var(--c-green)  0%, var(--c-green)  9%,  transparent 21%),
      radial-gradient(circle at 69% 82%, var(--c-pink)   0%, var(--c-pink)   8%,  transparent 20%),
      radial-gradient(circle at 84% 92%, var(--c-yellow) 0%, var(--c-yellow) 9%,  transparent 21%),
      radial-gradient(circle at 97% 76%, var(--c-orange) 0%, var(--c-orange) 8%,  transparent 20%),
      var(--c-turq);
    /* Colores a plena potencia: lo que se descubre bajo el trazo tiene que
       leerse como pintura recién puesta, no como un pastel. */
    filter: saturate(2.6) contrast(1.22) brightness(1.04);
    /*
      La deriva va por `transform`, no por `background-position`. Animar la
      posición del fondo obliga a repintar 28 degradados radiales en cada
      fotograma; con transform la capa se rasteriza una vez y el compositor la
      mueve. Además baja de 20 s a 8 s: bajo la brocha los colores cambian
      ahora más de dos veces más rápido.
    */
    will-change: transform;
    backface-visibility: hidden;
    animation: colorDrift 8s ease-in-out infinite alternate;
  }
  @keyframes colorDrift {
    0%   { transform: translate3d(-5%, -3.5%, 0) scale(1.04); }
    100% { transform: translate3d(5%, 3.5%, 0) scale(1.16); }
  }
  /* Trama diagonal muy sutil: da textura de pintura en vez de degradado liso. */
  .hero-color-layer::before {
    content: '';
    position: absolute;
    inset: 0;
    background-image: repeating-linear-gradient(115deg, rgba(255,255,255,0.07) 0 2px, transparent 2px 6px);
    mix-blend-mode: overlay;
  }

  /* ── Capa 1: la capa blanca que se borra ──────────────────────────── */
  .hero-white-layer {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    /* Hasta que el script la pinta, tapa el color por completo. */
    background: var(--gesso);
  }
  .hero-white-layer.ready { background: transparent; }

  /* ── Capa 2: contenido ────────────────────────────────────────────── */
  .hero-inner {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    align-items: center;
    min-height: 56vh;
  }

  .hero-message {
    font-family: var(--serif);
    font-weight: 500;
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    max-width: 520px;
    margin: 0 0 18px;
    line-height: 1.08;
  }
  .hero-sub {
    font-size: 0.95rem;
    opacity: 0.72;
    max-width: 440px;
    line-height: 1.55;
    margin-bottom: 32px;
  }
  .hero-ctas { display: flex; gap: 24px; align-items: center; flex-wrap: wrap; }

  /*
    ── El logotipo ────────────────────────────────────────────────────────
    Dos elementos anidados porque son dos animaciones con vidas distintas:

      .hero-gs        el "pintado": un canto diagonal barre el logotipo de
                      izquierda a derecha, como una pasada de brocha. Va en el
                      contenedor para no pelearse con las transformaciones.
      .hero-gs-inner  la entrada (sube, crece, se pasa de rosca y vuelve) y,
                      encadenada detrás, la respiración en reposo.

    Todo se anima con transform / opacity / clip-path: nada de esto provoca
    reflow ni repinta el logotipo.
  */
  .hero-gs {
    justify-self: end;
    user-select: none;
    width: clamp(220px, 30vw, 480px);
    animation: logoWipe 1.05s var(--ease-out-soft) .05s backwards;
  }
  .hero-gs-inner {
    position: relative;
    animation:
      logoIntro 1.25s var(--ease-overshoot) both,
      logoBreathe 7s ease-in-out 1.3s infinite;
    /* Dos sombras: una pegada al canto, que da grosor de pintura, y la de
       siempre, amplia y suave, que lo separa del fondo. */
    filter:
      drop-shadow(0 2px 1px rgba(0, 0, 0, 0.18))
      drop-shadow(0 20px 50px rgba(0, 0, 0, 0.22));
    will-change: transform;
    backface-visibility: hidden;
  }
  /* Realce de color del logotipo: más pigmento, sin tocar el archivo. */
  .hero-gs :global(img) {
    width: 100%;
    height: auto;
    display: block;
    filter: saturate(1.4) contrast(1.1);
  }

  /*
    Brillo de pintura húmeda. La banda es un hijo que se desplaza con
    `transform` (el compositor lo mueve solo) y el contenedor la recorta con la
    silueta del logotipo, así el reflejo nunca se sale de la pintura.
  */
  .hero-gs-gloss {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    mix-blend-mode: screen;
    -webkit-mask-image: var(--logo-mask);
    mask-image: var(--logo-mask);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }
  .gloss-band {
    position: absolute;
    top: -30%; bottom: -30%;
    left: -60%;
    width: 60%;
    background: linear-gradient(
      100deg,
      transparent 0%,
      rgba(255, 255, 255, 0.10) 35%,
      rgba(255, 255, 255, 0.55) 50%,
      rgba(255, 255, 255, 0.10) 65%,
      transparent 100%
    );
    transform: translate3d(0, 0, 0);
    animation: logoGloss 7s ease-in-out 2s infinite;
  }
  @keyframes logoGloss {
    0%       { transform: translate3d(0, 0, 0); }
    38%, 100% { transform: translate3d(310%, 0, 0); }
  }

  /*
    El recorte se sale mucho de la caja (de -74% a 214%) porque si no recorta
    la sombra proyectada y deja un rectángulo gris alrededor del logotipo.
    Y el relleno es `backwards`, no `both`: al terminar, el elemento vuelve a
    su `clip-path: none` y no queda ningún recorte permanente.
  */
  @keyframes logoWipe {
    0%   { clip-path: polygon(-60% -70%, -60% -70%, -74% 170%, -74% 170%); }
    100% { clip-path: polygon(-60% -70%, 214% -70%, 200% 170%, -74% 170%); }
  }
  @keyframes logoIntro {
    0%   { opacity: 0; transform: translate3d(0, 54px, 0) scale(.58) rotate(-9deg); }
    55%  { opacity: 1; transform: translate3d(0, -12px, 0) scale(1.10) rotate(3.5deg); }
    78%  { opacity: 1; transform: translate3d(0, 4px, 0)  scale(.965) rotate(-1.4deg); }
    100% { opacity: 1; transform: translate3d(0, 0, 0)    scale(1)    rotate(0deg); }
  }
  /* Reposo: flota, se balancea un grado escaso y respira. Lo justo para que
     no parezca una imagen pegada, sin robarle atención al mensaje. */
  @keyframes logoBreathe {
    0%   { transform: translate3d(0, 0, 0)     rotate(-0.7deg) scale(1); }
    50%  { transform: translate3d(0, -13px, 0) rotate(0.9deg)  scale(1.018); }
    100% { transform: translate3d(0, 0, 0)     rotate(-0.7deg) scale(1); }
  }
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; text-align: center; }
    .hero-message, .hero-sub { margin-left: auto; margin-right: auto; }
    .hero-ctas { justify-content: center; }
    .hero-gs { justify-self: center; width: clamp(160px, 45vw, 260px); margin-top: 10px; }
    /* En pantallas pequeñas el mismo recorrido se ve exagerado: se acorta. */
    .hero-gs-inner { animation-name: logoIntro, logoBreatheSm; }
    @keyframes logoBreatheSm {
      0%   { transform: translate3d(0, 0, 0)    rotate(-0.5deg) scale(1); }
      50%  { transform: translate3d(0, -8px, 0) rotate(0.6deg)  scale(1.014); }
      100% { transform: translate3d(0, 0, 0)    rotate(-0.5deg) scale(1); }
    }
  }

  /* Con movimiento reducido el logotipo aparece, pero ni rebota ni respira. */
  @media (prefers-reduced-motion: reduce) {
    .hero-gs { animation: none; clip-path: none; }
    .hero-gs-inner { animation: none; opacity: 1; transform: none; }
    .hero-gs-gloss { display: none; }
    .hero-color-layer { animation: none; }
  }

  /* ── Indicador de scroll ──────────────────────────────────────────── */
  .scroll-cue {
    position: absolute;
    bottom: 28px; left: 50%;
    transform: translateX(-50%);
    z-index: 2;
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--stone);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
  }
  .scroll-cue::after {
    content: '';
    width: 1px; height: 28px;
    background: var(--stone-light);
    animation: scrolldrop 2s ease-in-out infinite;
  }
  @keyframes scrolldrop {
    0%   { transform: scaleY(0); transform-origin: top; }
    50%  { transform: scaleY(1); transform-origin: top; }
    51%  { transform-origin: bottom; }
    100% { transform: scaleY(0); transform-origin: bottom; }
  }
</style>

<script>
  import { initHeroReveal } from '~/scripts/hero-reveal';
  import { initBrushCursor } from '~/scripts/brush-cursor';
  initHeroReveal();
  initBrushCursor();
</script>
