---
/**
 * EL LOGOTIPO DEL HERO — entra como si alguien tirase la pintura contra la
 * pantalla y de esa mancha saliera el logotipo.
 *
 * La secuencia son cuatro piezas encadenadas por retardos (no hay JavaScript:
 * son animaciones CSS que arrancan solas al cargar la página):
 *
 *   0 → 380 ms   .lt-blob    la bola de pintura entra volando desde fuera del
 *                            encuadre, acelerando y estirándose por la
 *                            velocidad. Desaparece justo en el impacto.
 *   380 ms       .lt-ring    la onda del choque: un anillo que se abre y se va.
 *   380 ms →     .lt-splat   la mancha, que revienta con rebote y se desvanece
 *                            por detrás del logotipo.
 *   380 ms →     .lt-drop    las salpicaduras salen disparadas en abanico.
 *                            Unas cuantas se quedan como motas tenues.
 *   440 ms →     el logotipo emerge de la mancha, crece pasándose de rosca y
 *                            se asienta. Detrás, la respiración de siempre.
 *
 * La bola y la mancha NO son formas dibujadas a mano: son la silueta del
 * propio logotipo (`--logo-mask`) rellena con la paleta de marca. Así la
 * pintura que se estampa es literalmente la misma forma de la que sale el
 * logotipo, y si algún día se cambia `DEFAULT_LOGO` la mancha cambia con él.
 */
import { getImage } from 'astro:assets';
import Logo from '~/components/Logo.astro';
import { LOGOS, DEFAULT_LOGO } from '~/lib/logo';
import { SITE } from '~/data/site';

/*
  La silueta con la que se recortan la bola, la mancha y el brillo húmedo.

  Se genera una copia pequeña a propósito. El PNG original pesa ~1,9 MB, y de
  él aquí sólo interesa el canal alfa: como máscara, medio megapíxel no aporta
  nada (la mancha va desenfocada 7 px encima). Y sobre todo, la entrada del
  logotipo DEPENDE de este archivo: si tarda en llegar, la bola y la mancha se
  animan invisibles y lo que se ve es el logotipo apareciendo solo.
*/
const mask = await getImage({
  src: LOGOS[DEFAULT_LOGO],
  width: 360,
  format: 'webp',
  quality: 80,
});
const logoMask = mask.src;

/**
 * Las salpicaduras. Los valores son fijos (no aleatorios) para que el servidor
 * y el navegador rendericen exactamente lo mismo.
 *
 *   a     ángulo de salida en grados
 *   d     distancia recorrida, en % del ancho del logotipo (cqw)
 *   s     tamaño de la gota, misma unidad
 *   t     retardo respecto al impacto
 *   stay  si se queda como mota tenue en vez de desvanecerse del todo
 *
 * El reparto de ángulos está sesgado hacia abajo-derecha: la bola llega desde
 * arriba-izquierda y una salpicadura real sigue la inercia del golpe.
 */
const DROPS = [
  { a: 38,  d: 74, s: 5.0, t: 0,  c: 'red',    stay: true },
  { a: 12,  d: 62, s: 3.4, t: 20, c: 'orange', stay: false },
  { a: 62,  d: 68, s: 4.2, t: 10, c: 'yellow', stay: true },
  { a: 88,  d: 55, s: 2.8, t: 40, c: 'green',  stay: false },
  { a: 118, d: 60, s: 3.6, t: 25, c: 'turq',   stay: false },
  { a: 150, d: 50, s: 2.4, t: 55, c: 'blue',   stay: true },
  { a: 178, d: 57, s: 3.0, t: 35, c: 'purple', stay: false },
  { a: 205, d: 46, s: 2.2, t: 65, c: 'pink',   stay: false },
  { a: 232, d: 52, s: 2.9, t: 30, c: 'red',    stay: false },
  { a: 258, d: 44, s: 2.0, t: 70, c: 'yellow', stay: true },
  { a: 285, d: 58, s: 3.3, t: 15, c: 'green',  stay: false },
  { a: 312, d: 49, s: 2.5, t: 60, c: 'blue',   stay: false },
  { a: 336, d: 66, s: 3.8, t: 5,  c: 'orange', stay: true },
  { a: 50,  d: 92, s: 2.6, t: 45, c: 'pink',   stay: false },
  { a: 26,  d: 86, s: 2.0, t: 75, c: 'turq',   stay: true },
  { a: 70,  d: 88, s: 2.3, t: 50, c: 'purple', stay: false },
];
---

<div class="logo-throw" style={`--logo-mask: url("${logoMask}");`}>
  <span class="lt-blob" aria-hidden="true"></span>
  <span class="lt-ring" aria-hidden="true"></span>
  <span class="lt-splat" aria-hidden="true"></span>

  <span class="lt-drops" aria-hidden="true">
    {DROPS.map((d) => (
      <i
        class:list={['lt-drop', { stay: d.stay }]}
        style={`--a: ${d.a}deg; --d: ${d.d}cqw; --s: ${d.s}cqw; --t: ${d.t}ms; --c: var(--c-${d.c});`}
      ></i>
    ))}
  </span>

  <div class="hero-gs-inner">
    <Logo width={520} eager alt={SITE.name} />
    <span class="hero-gs-gloss" aria-hidden="true"><span class="gloss-band"></span></span>
  </div>
</div>

<style>
  /*
    `container-type: inline-size` está aquí para que las salpicaduras puedan
    medirse en `cqw` (1% del ancho del logotipo). El logotipo va de 220 px a
    480 px según la pantalla: con distancias en píxeles el abanico saldría
    enorme en móvil y ridículo en escritorio.
  */
  .logo-throw {
    position: relative;
    container-type: inline-size;
  }

  /* ── 1. La bola de pintura que llega volando ──────────────────────── */
  .lt-blob {
    position: absolute;
    inset: 17%;
    z-index: 0;
    background: var(--rainbow-line);
    -webkit-mask-image: var(--logo-mask);
    mask-image: var(--logo-mask);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    filter: saturate(1.9) blur(1px);
    opacity: 0;
    will-change: transform, opacity;
    /*
      Curva de entrada acelerando (ease-in): un objeto lanzado no frena antes
      de chocar. La segunda animación sólo la borra en el instante del impacto.
    */
    animation:
      ltFly 380ms cubic-bezier(.5, .05, .7, .2) both,
      ltGone 1ms linear 380ms forwards;
  }
  @keyframes ltFly {
    0%   { opacity: 0; transform: translate3d(-190%, -215%, 0) rotate(-38deg) scale(.16); }
    14%  { opacity: 1; }
    70%  { transform: translate3d(-38%, -44%, 0) rotate(-14deg) scale(.52) scaleX(1.55); }
    100% { opacity: 1; transform: translate3d(0, 0, 0) rotate(0deg) scale(1.02) scaleY(.84); }
  }
  @keyframes ltGone { to { opacity: 0; } }

  /* ── 2. La onda del impacto ───────────────────────────────────────── */
  .lt-ring {
    position: absolute;
    left: 50%; top: 50%;
    width: 62%;
    aspect-ratio: 1;
    margin: -31% 0 0 -31%;
    z-index: 0;
    border-radius: 50%;
    background: var(--rainbow);
    /* Anillo, no disco: la máscara deja pasar sólo la corona. */
    -webkit-mask: radial-gradient(circle, transparent 60%, #000 63%, #000 70%, transparent 73%);
    mask: radial-gradient(circle, transparent 60%, #000 63%, #000 70%, transparent 73%);
    opacity: 0;
    will-change: transform, opacity;
    animation: ltRing 620ms var(--ease-out-soft) 380ms both;
  }
  @keyframes ltRing {
    0%   { opacity: .8; transform: scale(.25); }
    100% { opacity: 0;  transform: scale(2.1); }
  }

  /* ── 3. La mancha ─────────────────────────────────────────────────── */
  .lt-splat {
    position: absolute;
    inset: -6%;
    z-index: 0;
    background: var(--rainbow);
    -webkit-mask-image: var(--logo-mask);
    mask-image: var(--logo-mask);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
    /* Desenfocada: es pintura estampada, no una copia nítida del logotipo. */
    filter: saturate(1.7) blur(7px);
    opacity: 0;
    will-change: transform, opacity;
    animation: ltSplat 900ms var(--ease-overshoot) 380ms both;
  }
  @keyframes ltSplat {
    0%   { opacity: 0;   transform: scale(.34) rotate(-8deg); }
    14%  { opacity: .95; transform: scale(1.22) rotate(2deg); }
    34%  { opacity: .78; transform: scale(1.02) rotate(-1deg); }
    100% { opacity: 0;   transform: scale(1.12) rotate(0deg); }
  }

  /* ── 4. Las salpicaduras ──────────────────────────────────────────── */
  .lt-drops { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .lt-drop {
    position: absolute;
    left: 50%; top: 50%;
    width: var(--s);
    height: calc(var(--s) * .68);
    margin: calc(var(--s) * -.34) 0 0 calc(var(--s) * -.5);
    background: var(--c);
    /* Radios desiguales: una gota de pintura no es un círculo. */
    border-radius: 62% 38% 55% 45% / 58% 46% 54% 42%;
    filter: saturate(1.5);
    opacity: 0;
    will-change: transform, opacity;
    animation: ltDrop 780ms var(--ease-out-soft) calc(380ms + var(--t)) both;
  }
  /*
    `rotate` primero y `translateX` después: así la gota sale en línea recta
    hacia su ángulo y además queda apuntando hacia fuera, que es como vuela
    una gota de verdad.
  */
  @keyframes ltDrop {
    0%   { opacity: 0; transform: rotate(var(--a)) translateX(4cqw) scale(.2); }
    16%  { opacity: 1; }
    74%  { opacity: 1; transform: rotate(var(--a)) translateX(var(--d)) scale(1); }
    100% { opacity: 0; transform: rotate(var(--a)) translateX(calc(var(--d) * 1.05)) scale(.82); }
  }
  /* Las que se quedan: motas apagadas alrededor del logotipo. Sin ellas el
     impacto no deja rastro y el efecto se olvida en cuanto termina. */
  .lt-drop.stay { animation-name: ltDropStay; }
  @keyframes ltDropStay {
    0%   { opacity: 0;   transform: rotate(var(--a)) translateX(4cqw) scale(.2); }
    16%  { opacity: 1; }
    74%  { opacity: 1;   transform: rotate(var(--a)) translateX(var(--d)) scale(1); }
    100% { opacity: .32; transform: rotate(var(--a)) translateX(calc(var(--d) * 1.03)) scale(.9); }
  }

  /* ── 5. El logotipo saliendo de la mancha ─────────────────────────── */
  .hero-gs-inner {
    position: relative;
    z-index: 1;
    animation:
      ltLogoBurst 1s var(--ease-overshoot) 440ms both,
      logoBreathe 7s ease-in-out 1.75s infinite;
    /* Dos sombras: una pegada al canto, que da grosor de pintura, y la de
       siempre, amplia y suave, que lo separa del fondo. */
    filter:
      drop-shadow(0 2px 1px rgba(0, 0, 0, 0.18))
      drop-shadow(0 20px 50px rgba(0, 0, 0, 0.22));
    will-change: transform;
    backface-visibility: hidden;
  }
  /*
    Arranca diminuto y girado dentro de la mancha, se pasa de tamaño y vuelve.
    Aquí NO se anima `filter`: la propiedad ya lleva las dos sombras y una
    keyframe que la tocara las borraría al terminar (el relleno es `both`).
  */
  @keyframes ltLogoBurst {
    0%   { opacity: 0; transform: scale(.24) rotate(-15deg); }
    24%  { opacity: 1; }
    58%  { transform: scale(1.11) rotate(4.5deg); }
    78%  { transform: scale(.972) rotate(-1.8deg); }
    100% { opacity: 1; transform: scale(1) rotate(0deg); }
  }
  /* Reposo: flota, se balancea un grado escaso y respira. Lo justo para que
     no parezca una imagen pegada, sin robarle atención al mensaje. */
  @keyframes logoBreathe {
    0%   { transform: translate3d(0, 0, 0)     rotate(-0.7deg) scale(1); }
    50%  { transform: translate3d(0, -13px, 0) rotate(0.9deg)  scale(1.018); }
    100% { transform: translate3d(0, 0, 0)     rotate(-0.7deg) scale(1); }
  }

  /* Realce de color del logotipo: más pigmento, sin tocar el archivo. */
  .logo-throw :global(img) {
    width: 100%;
    height: auto;
    display: block;
    filter: saturate(1.4) contrast(1.1);
  }

  /*
    Brillo de pintura húmeda. La banda es un hijo que se desplaza con
    `transform` (el compositor lo mueve solo) y el contenedor la recorta con la
    silueta del logotipo, así el reflejo nunca se sale de la pintura.
  */
  .hero-gs-gloss {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
    mix-blend-mode: screen;
    -webkit-mask-image: var(--logo-mask);
    mask-image: var(--logo-mask);
    -webkit-mask-size: 100% 100%;
    mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }
  .gloss-band {
    position: absolute;
    top: -30%; bottom: -30%;
    left: -60%;
    width: 60%;
    background: linear-gradient(
      100deg,
      transparent 0%,
      rgba(255, 255, 255, 0.10) 35%,
      rgba(255, 255, 255, 0.55) 50%,
      rgba(255, 255, 255, 0.10) 65%,
      transparent 100%
    );
    transform: translate3d(0, 0, 0);
    /* Empieza cuando el logotipo ya se ha asentado: si no, el reflejo barre
       una forma que todavía está creciendo y no se lee. */
    animation: logoGloss 7s ease-in-out 2.4s infinite;
  }
  @keyframes logoGloss {
    0%        { transform: translate3d(0, 0, 0); }
    38%, 100% { transform: translate3d(310%, 0, 0); }
  }

  @media (max-width: 900px) {
    /* En pantallas pequeñas el mismo recorrido se ve exagerado: se acorta. */
    .hero-gs-inner { animation-name: ltLogoBurst, logoBreatheSm; }
    @keyframes logoBreatheSm {
      0%   { transform: translate3d(0, 0, 0)    rotate(-0.5deg) scale(1); }
      50%  { transform: translate3d(0, -8px, 0) rotate(0.6deg)  scale(1.014); }
      100% { transform: translate3d(0, 0, 0)    rotate(-0.5deg) scale(1); }
    }
  }

  /* Con movimiento reducido no se lanza nada: el logotipo ya está puesto. */
  @media (prefers-reduced-motion: reduce) {
    .lt-blob, .lt-ring, .lt-splat, .lt-drops, .hero-gs-gloss { display: none; }
    .hero-gs-inner { animation: none; opacity: 1; transform: none; }
  }
</style>
