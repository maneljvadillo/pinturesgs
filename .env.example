# ─────────────────────────────────────────────────────────────
#  PINTURESGS — variables de entorno
#  Copia este archivo a `.env` y rellena los valores reales.
#  `.env` está en .gitignore: nunca se sube al repositorio.
# ─────────────────────────────────────────────────────────────

# Resend — envío del formulario de presupuesto.
# Alta gratuita en https://resend.com (3.000 emails/mes).
# Sin esta clave el formulario NO falla: en desarrollo escribe
# el email por consola para que puedas probarlo.
RESEND_API_KEY=

# Remitente. Debe ser un dominio verificado en Resend.
# Mientras no verifiquéis pinturesgs.com, Resend permite usar
# "onboarding@resend.dev" solo para pruebas.
BUDGET_MAIL_FROM="PINTURESGS <presupuestos@pinturesgs.com>"

# Dónde llegan las solicitudes de presupuesto.
# Acepta varios separados por coma.
# Si se deja vacía, los avisos van al correo de la empresa que hay en
# src/data/site.ts (pinturesgs@gmail.com). Admite varias, separadas por comas.
BUDGET_MAIL_TO=pinturesgs@gmail.com
